# macOS and editor metadata
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local configuration and credentials
.env
.env.*
*.env
*.env.*
!*.env.example
*.pem
*.key
*.p12
# Only age-encrypted SOPS documents may be tracked here. Plaintext secret files
# and decrypted editor output remain ignored.
secrets/*
!secrets/*.sops.yaml

# Generated logs, caches, and local test output
*.log
__pycache__/
*.py[cod]
.cache/
tmp/
artifacts/

# Local agent-harness runtime state (policies intended for deployment belong in
# reviewed configuration files, not tool-generated state directories).
.claude-flow/
.claude/
.swarm/
**/benchmarks/private/

# Local model and database data
models/
*.db
*.sqlite
*.sqlite3
