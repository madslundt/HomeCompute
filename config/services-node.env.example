# Copy this file outside the repository, fill every REQUIRED value, then run:
#   sudo ./scripts/setup-services-node.sh validate --env /etc/ai-platform/services-node.env
#
# This file is sourced as root by the provisioning script. It is trusted
# operator configuration and must not contain shell commands or secrets.

# Expected Proxmox VE major release. The script refuses another major release
# until its commands and defaults have been reviewed.
PVE_MAJOR_VERSION=9
PVE_HOSTNAME=ai-services-01
TIMEZONE=Europe/Copenhagen

# Proxmox storage and bridges created during the interactive ISO installation.
# local must have the "Snippets" content type enabled before create-template.
VM_STORAGE=local-lvm
SNIPPET_STORAGE=local
LAN_BRIDGE=vmbr0
COMPUTE_BRIDGE=vmbr1

# The services node's second physical NIC should back vmbr1. It is a private,
# non-routed link to ai-compute-01; do not configure a gateway on it.
COMPUTE_PRIVATE_CIDR=10.77.10.0/24
COMPUTE_EXPECTED_IP=10.77.10.10

# Debian 13 generic cloud image. "latest" is allowed only because the exact
# downloaded bytes are pinned below. Record the published SHA-512 value before
# running create-template.
CLOUD_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
CLOUD_IMAGE_SHA512=REPLACE_WITH_128_HEX_SHA512
CLOUD_IMAGE_CACHE=/var/lib/vz/template/iso/debian-13-genericcloud-amd64.qcow2
TEMPLATE_ID=9000
TEMPLATE_NAME=debian-13-services

# Public key only. Create this file on the Proxmox host; private keys never go
# on the host or in this repository.
VM_ADMIN_USER=ops
SSH_PUBLIC_KEY_FILE=/root/services-node-admin.pub
DNS_SERVER=REPLACE_WITH_LAN_DNS_IP
DNS_SEARCH_DOMAIN=home.arpa
LAN_GATEWAY=REPLACE_WITH_LAN_GATEWAY_IP

# VM 110: authenticated edge, LiteLLM, its dedicated PostgreSQL/Redis, and
# metadata-only monitoring. It alone receives a second NIC to ai-compute-01.
GATEWAY_VM_ID=110
GATEWAY_VM_NAME=ai-gateway-01
GATEWAY_VM_IP=REPLACE_WITH_GATEWAY_IP/CIDR
GATEWAY_VM_COMPUTE_IP=10.77.10.2/24
GATEWAY_VM_CORES=4
GATEWAY_VM_MEMORY_MB=8192
GATEWAY_VM_BALLOON_MB=6144
GATEWAY_VM_DISK=120G

# VM 120: n8n, MCP servers, queues, browser workers, and later a separately
# qualified personal-agent runtime. Durable workflow state belongs here.
AUTOMATION_VM_ID=120
AUTOMATION_VM_NAME=automation-01
AUTOMATION_VM_IP=REPLACE_WITH_AUTOMATION_IP/CIDR
AUTOMATION_VM_CORES=6
AUTOMATION_VM_MEMORY_MB=16384
AUTOMATION_VM_BALLOON_MB=10240
AUTOMATION_VM_DISK=300G

# VM 130: development frameworks, CI/build jobs, and untrusted or experimental
# tool execution. Put it on a restricted VLAN when the router supports one.
TOOLBOX_VM_ID=130
TOOLBOX_VM_NAME=toolbox-01
TOOLBOX_VM_IP=REPLACE_WITH_TOOLBOX_IP/CIDR
TOOLBOX_GATEWAY=REPLACE_WITH_TOOLBOX_GATEWAY_IP
TOOLBOX_DNS_SERVER=REPLACE_WITH_TOOLBOX_DNS_IP
TOOLBOX_VM_CORES=6
TOOLBOX_VM_MEMORY_MB=12288
TOOLBOX_VM_BALLOON_MB=8192
TOOLBOX_VM_DISK=300G
TOOLBOX_VLAN_TAG=0

# VM disks are thin-provisioned, but their configured maximums still need to
# fit the storage and backup plan.

# Provisioning is deliberately two-stage. Leave false for the first run,
# inspect `qm config`, then set true or start guests manually.
START_VMS=false
