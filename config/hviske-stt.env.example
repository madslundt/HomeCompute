# Dedicated, opt-in Danish STT profile for home-spark. Copy outside the repo to
# /etc/gb10-ai/hviske.env, replace the runtime identity, and review the license
# decision before any state-changing command.

COMPUTE_NODE_NAME=home-spark
GB10_ROOT=/srv/gb10-ai
GB10_RUNTIME_UID=REPLACE_WITH_GB10_AI_UID
GB10_RUNTIME_GID=REPLACE_WITH_GB10_AI_GID

# NVIDIA 26.04 ARM64 contains vLLM 0.19.0 and Transformers 4.57.6, matching the
# publisher-tested Hviske v5.3 runtime tuple.
HVISKE_IMAGE=nvcr.io/nvidia/vllm@sha256:ebd2b86dd262729d44df230961bd42d623b39490adef4bf16e7f11dda5a6098d
HVISKE_MODEL_ID=syvai/hviske-v5.3
HVISKE_MODEL_REVISION=5d1a09822018702dc51d763e3a867b62d26b3501
HVISKE_MODEL_LICENSE_ID=cc-by-nc-4.0

# Keep loopback until the physical home-core <-> home-spark link and the exact
# 10301/tcp ingress rule are verified. The vLLM HTTP listener is internal-only.
GB10_BIND_ADDRESS=127.0.0.1
HVISKE_WYOMING_PORT=10301
GATEWAY_CIDR=REPLACE_WITH_AI_GATEWAY_IP_OR_CIDR
VLLM_API_KEY_FILE=/etc/gb10-ai/secrets/vllm_api_key

# Activation is fail-closed. Set this to personal-noncommercial only after the
# owner confirms that classification, or to syvai-commercial-license-approved
# after documented license approval.
HVISKE_LICENSE_DECISION=review-required
HVISKE_PRIVATE_INGRESS_CONFIRMED=false

HVISKE_GPU_MEMORY_UTILIZATION=0.10
HVISKE_MAX_NUM_SEQS=4
HVISKE_MAX_AUDIO_BYTES=10000000
HVISKE_MAX_AUDIO_SECONDS=60
HVISKE_UPSTREAM_TIMEOUT_SECONDS=120
HVISKE_MAX_CONNECTIONS=4
HVISKE_ARTIFACT_MAX_BYTES=6000000000
HVISKE_ARTIFACT_MAX_FILES=32
HF_CACHE_MAX_BYTES=536870912000
HF_CACHE_MAX_FILES=50000
MIN_FREE_DISK_GIB=200
