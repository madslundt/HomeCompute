{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "enabled_providers": ["homecompute"],
  "model": "homecompute/automation-moe",
  "small_model": "homecompute/automation-moe",
  "provider": {
    "homecompute": {
      "name": "HomeCompute LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://home-core.tail479ad.ts.net:8443/v1",
        "apiKey": "{env:OPENCODE_LITELLM_API_KEY}"
      },
      "models": {
        "automation-moe": {
          "name": "HomeCompute local coding model",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}
