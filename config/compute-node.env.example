# Copy this file outside the repository, fill every REQUIRED value, then run:
#   sudo ./scripts/setup-compute-node.sh validate --env /etc/gb10-ai/gb10.env
#
# Production apply rejects floating images, non-commit model revisions,
# wildcard binds, a missing exact ingress policy, and insecure secret permissions.
#
# The deployment id selects its immutable artifact and runtime recipe from
# config/model-catalog.json. This launcher currently implements the catalog's
# vLLM runtime family; SGLang/DFlash and Flash-Next remain separate profiles.

# Stable role name for the physical compute node. Hardware/vendor names remain
# inventory attributes, not hostnames or client-facing API names.
COMPUTE_NODE_NAME=home-spark

# Pinned NVIDIA vLLM 26.08 Linux/ARM64 baseline image. The Qwen3.8/MTP tuple
# still needs live GX10 qualification; the digest, not the tag, is its identity.
VLLM_IMAGE=nvcr.io/nvidia/vllm@sha256:d049bead397430803ac5b705d50094492f23782716677d746ab721e43f054cf6

# Legacy modality-scaffold image. Piper is not in the final roster; do not use
# this profile for the new speech deployment.
PIPER_IMAGE=rhasspy/wyoming-piper:2.4.3@sha256:f7aaafe325d18979f43a9fe8bb4db494ba28ce8c109cb982983157817705ff87

# Selected production workhorse. Routing remains disabled until this exact
# runtime tuple passes the live Codex/tool/Danish/mixed-load gates.
MODEL_DEPLOYMENT_ID=general-spark-qwen38
MODEL_ID=unsloth/Qwen3.8-27B-NVFP4

# Immutable publisher revision for the model, tokenizer, and remote code. Keep
# the fields separate so a future tuple can pin them independently.
MODEL_REVISION=57926baca9a82b4d6906b43f2750d55315f5b10f
TOKENIZER_REVISION=57926baca9a82b4d6906b43f2750d55315f5b10f
CODE_REVISION=57926baca9a82b4d6906b43f2750d55315f5b10f

# Gate C0 provenance inputs. Verify these against the pinned publisher artifact
# before install; they are copied into the secret-free release record.
MODEL_PROVENANCE_URL=https://huggingface.co/unsloth/Qwen3.8-27B-NVFP4
MODEL_LICENSE_ID=apache-2.0
MODEL_WEIGHT_FORMAT=compressed-tensors-safetensors
# SHA-256 of chat_template.jinja at the pinned tokenizer revision.
MODEL_QUANTIZATION=nvfp4
CHAT_TEMPLATE_SHA256=12827f24b742ea4e80cdc12dbcf9622227056b9f797252a3149263d4f9aaadce

# Installation root on the compute appliance.
GB10_ROOT=/srv/gb10-ai

# setup-compute-node.sh init replaces these values with the numeric service
# account identity. Compose then runs the container with that pinned identity.
GB10_RUNTIME_UID=REPLACE_WITH_INIT_UID
GB10_RUNTIME_GID=REPLACE_WITH_INIT_GID

# Start text on loopback. After direct qualification, change this to the compute
# node's non-routed private address and replace the gateway placeholder below.
# COMPUTE_HOST_PORTS is the exact sorted, unique ingress set used by the
# repository-owned firewall policy. GATEWAY_CIDR is the only permitted source.
# After editing these values, install the persistent policy:
#   sudo ./scripts/setup-compute-node.sh firewall --env /etc/gb10-ai/gb10.env
GB10_BIND_ADDRESS=127.0.0.1
VLLM_HOST_PORT=8000
AUTOMATION_HOST_PORT=8005
EMBEDDING_HOST_PORT=8001
VISION_HOST_PORT=8002
STT_HOST_PORT=8003
TTS_HOST_PORT=8004
WYOMING_TTS_HOST_PORT=10200
PLAPRE_WYOMING_PORT=10201
HVISKE_WYOMING_PORT=10301
COMPUTE_HOST_PORTS=8000,8001,8002,8003,8004,8005,10200,10201,10301
GATEWAY_CIDR=REPLACE_WITH_AI_GATEWAY_IP_OR_CIDR

# Secret files live outside source control. The operator supplies the Hugging
# Face token used only by the existing text acquisition profile. All staged
# modality artifacts are public and fetched account-free. The shared API key
# is mounted only into HTTP runtimes, never artifact acquisition.
HF_TOKEN_FILE=/etc/gb10-ai/secrets/hf_token
VLLM_API_KEY_FILE=/etc/gb10-ai/secrets/vllm_api_key

# Dedicated n8n/tool-calling MoE lane. It is a separate, qualification-gated
# vLLM process and never replaces the primary model by changing only MODEL_ID.
AUTOMATION_MODEL_ID=unsloth/Qwen3.6-35B-A3B-NVFP4
AUTOMATION_MODEL_REVISION=739af1e7aac320af1682ed1e0cce369af4c5265d
AUTOMATION_TOKENIZER_REVISION=739af1e7aac320af1682ed1e0cce369af4c5265d
AUTOMATION_CODE_REVISION=739af1e7aac320af1682ed1e0cce369af4c5265d
AUTOMATION_MODEL_LICENSE_ID=apache-2.0
AUTOMATION_MODEL_QUANTIZATION=NVFP4
AUTOMATION_CHAT_TEMPLATE_SHA256=e84f32a23fdda27689f868aa4a1a5621f41133e51a48d7f3efcbea2839574259
AUTOMATION_ARTIFACT_MAX_BYTES=28000000000
AUTOMATION_ARTIFACT_MAX_FILES=32
AUTOMATION_MAX_MODEL_LEN=131072
AUTOMATION_MAX_NUM_SEQS=4
AUTOMATION_MAX_BATCHED_TOKENS=8192
AUTOMATION_GPU_MEMORY_UTILIZATION=0.40
AUTOMATION_MOE_BACKEND=cutlass
AUTOMATION_FP8_MOE_BACKEND=triton
AUTOMATION_TOOL_CALL_PARSER=qwen3_coder
AUTOMATION_SPECULATIVE_CONFIG=''
AUTOMATION_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'

# Legacy pre-decision modality artifacts retained only so the old scaffold can
# be reproduced. They are not the final speech stack in gb10-model-roster.json.
EMBEDDING_MODEL_ID=Qwen/Qwen3-VL-Embedding-2B
EMBEDDING_MODEL_REVISION=9f2f7e710d6d81056aa5c0a4f04764fec6bb7bda
EMBEDDING_MODEL_LICENSE_ID=Apache-2.0
EMBEDDING_GPU_MEMORY_UTILIZATION=0.10

VISION_MODEL_ID=microsoft/Phi-4-multimodal-instruct
VISION_MODEL_REVISION=93f923e1a7727d1c4f446756212d9d3e8fcc5d81
VISION_MODEL_LICENSE_ID=MIT
VISION_GPU_MEMORY_UTILIZATION=0.18

STT_MODEL_ID=openai/whisper-large-v3-turbo
STT_MODEL_REVISION=41f01f3fe87f28c78e2fbf8b568835947dd65ed9
STT_MODEL_LICENSE_ID=MIT
STT_GPU_MEMORY_UTILIZATION=0.06

# The pinned Danish Piper voice derives from a CC0 dataset. Acquisition writes
# only these three verified files beneath GB10_ROOT/models/piper.
PIPER_VOICE_ID=da_DK-talesyntese-medium
PIPER_VOICE_REVISION=1162a9173d0ce503555aed757976b7a9912eae4c
PIPER_VOICE_LICENSE_ID=CC0-1.0
PIPER_MODEL_SHA256=b9271efd25f7b8494bbd28d48dd675c8c119daa284f3ee488008935f515f1241
PIPER_CONFIG_SHA256=89fe13bd251406cc0088570d103ea7ac35823211d8466faf913268ab8506f41b
PIPER_MODEL_CARD_SHA256=b5b7a51d4d815a307594619a519eb389b2e17839b30c0eb69a39d3ade5b1ed65

# The adapter accepts only these OpenAI model/voice aliases and bounded input.
TTS_MODEL_ALIAS=tts
TTS_VOICE_ALIAS=danish-default
TTS_MAX_INPUT_CHARS=2000

# Independently reviewed acquisition ceilings for these exact revisions.
# files_metadata is checked before download; the fetch parent also enforces the
# absolute cache allocation/file ceilings and 200 GiB free-space reserve while
# the child downloads. Requalify these values with every artifact change.
TEXT_ARTIFACT_MAX_BYTES=25000000000
TEXT_ARTIFACT_MAX_FILES=32
EMBEDDING_ARTIFACT_MAX_BYTES=5000000000
EMBEDDING_ARTIFACT_MAX_FILES=32
VISION_ARTIFACT_MAX_BYTES=25000000000
VISION_ARTIFACT_MAX_FILES=64
STT_ARTIFACT_MAX_BYTES=7000000000
STT_ARTIFACT_MAX_FILES=32
HF_CACHE_MAX_BYTES=536870912000
HF_CACHE_MAX_FILES=50000

# REQUIRED: free space gate, in GiB, on the filesystem containing GB10_ROOT.
# Production enforces at least 200 GiB for the pinned image, model snapshots,
# caches, and rollback artifacts. Only ALLOW_UNSUPPORTED_HOST=true permits a
# lower value, and such a run cannot produce production acceptance evidence.
MIN_FREE_DISK_GIB=200

# Serve the coding/general model with a 128K window; the pinned model supports
# a longer native window, but that requires separate memory qualification.
VLLM_MAX_MODEL_LEN=131072
VLLM_MAX_NUM_SEQS=2
VLLM_MAX_BATCHED_TOKENS=8192
VLLM_GPU_MEMORY_UTILIZATION=0.40
VLLM_SHM_SIZE=16gb

# Initial Qwen3.8 baseline recipe. Changing any of these creates a new artifact
# tuple and requires requalification.
VLLM_ATTENTION_BACKEND=flashinfer
VLLM_MOE_BACKEND=marlin
VLLM_REASONING_PARSER=qwen3
VLLM_TOOL_CALL_PARSER=qwen3_coder

# Qwen3.8 shares the Qwen3.5 native MTP head design. This is the simple/stable
# baseline that will be compared with the separate SGLang/DFlash profile.
VLLM_SPECULATIVE_CONFIG='{"method":"qwen3_5_mtp","num_speculative_tokens":3}'

# Qwen thinking is opt-in for the normal workflow-first lane. Callers may
# override this request-by-request after their alias/use case is qualified.
VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'

# Set true only for an explicitly documented non-GB10 test host. Production
# acceptance must remain false and run on the actual appliance.
ALLOW_UNSUPPORTED_HOST=false
