# Copy to the deployment's private environment file and set values there.
# Do not put secret contents in this file; Docker Compose mounts the paths below
# as read-only secrets. Ensure these files are readable by the local Compose user.
MODEL_MANAGER_USERNAME_SECRET=/run/secrets/model-manager/username
MODEL_MANAGER_PASSWORD_SECRET=/run/secrets/model-manager/password
MODEL_MANAGER_SSH_KEY_SECRET=/run/secrets/model-manager/spark-ssh-key
MODEL_MANAGER_KNOWN_HOSTS_SECRET=/etc/homecompute/model-manager-known-hosts

# `user@host` must use a dedicated SSH key restricted server-side to the
# no-argument sparkrun model manager adapter. Host key verification is strict.
MODEL_MANAGER_SSH_TARGET=sparkrun-manager@192.168.30.126

# Exact browser origin; this must match the eventual HTTPS Caddy hostname.
MODEL_MANAGER_PUBLIC_ORIGIN=https://models.home.arpa

# Caddy's static address on the private clients network.
CADDY_CLIENTS_IP=172.28.210.2

# Keep the app stopped until the Spark forced-command key and sudo allowlist
# have been deployed and verified.
MODEL_MANAGER_SPARK_FORCED_COMMAND_READY=0

# Use the checked out HomeCompute source commit SHA as the local image tag.
MODEL_MANAGER_RELEASE=replace-with-release-sha
