# Proposed guest-side OpenClaw canary; secret-free, not sourced/deployed automatically.
# NemoClaw 0.0.129 / OpenShell 0.0.116 / OpenClaw 2026.9.1 stay one tuple.
NEMOCLAW_INSTALL_REF=26922313bba96184e65c3663b351683ebae9504d
NEMOCLAW_INSTALL_TAG=v0.0.129
NEMOCLAW_AGENT=openclaw
NEMOCLAW_SANDBOX_NAME=agent-openclaw
# Distinct OpenShell gateway and registry; Hermes stays on its existing gateway.
NEMOCLAW_GATEWAY_PORT=9123
NEMOCLAW_GATEWAY_BIND_ADDRESS=127.0.0.1
NEMOCLAW_DASHBOARD_PORT=18791
NEMOCLAW_PROVIDER=custom
NEMOCLAW_ENDPOINT_URL=http://ai.home.arpa:18080/v1
NEMOCLAW_TRUSTED_PRIVATE_HOSTS=ai.home.arpa
NEMOCLAW_MODEL=automation-moe
NEMOCLAW_POLICY_TIER=restricted
# Skip optional additions; narrow the live base to managed_inference after creation.
# The pinned CLI rejects a blank custom preset list during a fresh run.
NEMOCLAW_POLICY_MODE=skip
NEMOCLAW_WEB_SEARCH_PROVIDER=none
NEMOCLAW_TOOL_DISCLOSURE=direct
NEMOCLAW_CONTEXT_WINDOW=32768
NEMOCLAW_MAX_TOKENS=4096
NEMOCLAW_REASONING=false
NEMOCLAW_AGENT_TIMEOUT=660
NEMOCLAW_AGENT_HEARTBEAT_EVERY=0m
NEMOCLAW_CPU=1
NEMOCLAW_RAM=8Gi
NEMOCLAW_SANDBOX_GPU=0
# The managed workload owns its exact verified image pin.
# Do not set legacy NEMOCLAW_SANDBOX_BASE_IMAGE_REF/LOCAL_BUILD overrides.
NEMOCLAW_CORPORATE_CA_BUNDLE=/etc/homecompute-openclaw/home-core-root.crt
# Wrapper/operator input; NEVER put COMPATIBLE_API_KEY bytes in this template.
OPENCLAW_NEMOCLAW_MODEL_KEY_FILE=/etc/homecompute-openclaw/secrets/litellm-agent-openclaw
OPENCLAW_NEMOCLAW_CONFIG_OVERLAY=/etc/homecompute-openclaw/openclaw-nemoclaw.json
