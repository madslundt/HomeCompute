# Approved stable image, qualified against an isolated restore before deployment.
N8N_IMAGE=n8nio/n8n:2.46.0@sha256:0a0e0640806e9426ab9c1498186175332810551b28129b5cfcd36060a9623f32
N8N_STATE_ROOT=/srv/state/automation/n8n
N8N_MCP_CLIENTS_IP=172.28.211.3
AULA_MCP_STATE_ROOT=/srv/state/automation/aula-mcp
AULA_MCP_BACKENDS_IP=172.28.212.3
TILBUDSTROLDEN_STATE_ROOT=/srv/state/automation/tilbudstrolden-mcp

# Parallel Home Core manager for transition from the Notion AI automations.
# Enabled for the Home Core private LAN service; secrets are provisioned via SOPS.
AI_AUTOMATION_MANAGER_ENABLED=1
AI_AUTOMATION_MANAGER_RELEASE=replace-with-reviewed-full-commit-sha
AI_AUTOMATION_PUBLIC_ORIGIN=https://automations.home.arpa
AI_AUTOMATION_STATE_ROOT=/srv/state/automation/ai-automation-manager
AI_AUTOMATION_INBOX_ENV_SECRET=/run/secrets/automation/inbox-webhook-env
AI_AUTOMATION_WORKFLOW_TOKEN_SECRET=/run/secrets/automation/ai-automation-workflow-token
AI_AUTOMATION_USERNAME_SECRET=/run/secrets/automation/ai-automation-username
AI_AUTOMATION_PASSWORD_SECRET=/run/secrets/automation/ai-automation-password
TILBUDSTROLDEN_MCP_BACKENDS_IP=172.28.212.4
BANKNORWEGIAN_MCP_STATE_ROOT=/srv/state/automation/banknorwegian-mcp
BANKNORWEGIAN_MCP_BACKENDS_IP=172.28.212.5
# Bank Norwegian Open Banking (developer.banknorwegian.com app registration).
# BN_CLIENT_SECRET is an external secret: set it only in the root-only host
# file /etc/homecompute/automation.env, never in Git or the sops-tracked files.
BN_CLIENT_ID=
BN_CLIENT_SECRET=
BN_SANDBOX=true
BN_REGION=NO
BN_PSU_ID=homecompute-owner
BN_REDIRECT_URI=http://home-core:17880/callback
BN_CA_FILE=/data/psd2-roots.pem
HOMECOMPUTE_CA_CERT_FILE=/srv/state/automation/certs/homecompute-caddy-root.crt
