# Guest-side, non-secret configuration for the household owner agent.
# Copy this file to a directory owned by the unprivileged guest operator and
# set mode 0600. Store the API key only in the separate file named below.
HERMES_SANDBOX_NAME=hermes-personal-v2
HERMES_ENDPOINT_URL=http://ai.home.arpa:18080/v1
HERMES_MODEL=automation-moe
HERMES_TRUSTED_PRIVATE_HOSTS=ai.home.arpa,home-core.tail479ad.ts.net
HERMES_CA_BUNDLE=/home/hermes-operator/.config/homecompute-hermes/certs/home-core-root.crt
HERMES_LITELLM_API_KEY_FILE=/home/hermes-operator/.config/homecompute-hermes/secrets/litellm-agent-owner
HERMES_EVIDENCE_DIR=/var/lib/homecompute-hermes/evidence
HERMES_RESTORE_TARGET=hermes-personal-v2
HERMES_MATTERMOST_URL=https://home-core.tail479ad.ts.net:9443
HERMES_MATTERMOST_TOKEN_FILE=/home/hermes-operator/.config/homecompute-hermes/secrets/mattermost-agent
HERMES_MATTERMOST_ALLOWED_USERS=1oipaix7gin73jczp97tcfmyac
# Require fresh off-host Synology restore and agents-network evidence.
HERMES_BACKUP_READINESS_FILE=/var/lib/homecompute-hermes/gates/backup-readiness.json
HERMES_NETWORK_READINESS_FILE=/var/lib/homecompute-hermes/gates/agents-network.json
