# Guest-side, non-secret configuration for the synthetic owner canary.
# Copy this file to a directory owned by the unprivileged guest operator and
# set mode 0600. Store the API key only in the separate file named below.
HERMES_SANDBOX_NAME=agent-owner
HERMES_ENDPOINT_URL=https://ai.home.arpa/v1
HERMES_MODEL=assistant-canary
HERMES_TRUSTED_PRIVATE_HOSTS=ai.home.arpa
HERMES_CA_BUNDLE=/etc/homecompute-hermes/home-core-root.crt
HERMES_LITELLM_API_KEY_FILE=/etc/homecompute-hermes/secrets/litellm-agent-owner
HERMES_EVIDENCE_DIR=/var/lib/homecompute-hermes/evidence
HERMES_RESTORE_TARGET=agent-owner-verify
HERMES_BACKUP_READINESS_FILE=/var/lib/homecompute-hermes/gates/off-host-backup.json
HERMES_NETWORK_READINESS_FILE=/var/lib/homecompute-hermes/gates/agents-network.json
