# Copy to a root-owned, mode-0600 runtime file outside the Git checkout and
# replace every REQUIRED placeholder. sops-nix materializes the secret files.

TIMEZONE=Europe/Copenhagen
CONTROL_PLANE_STATE_ROOT=/srv/state/control-plane
CONTROL_PLANE_SECRET_GID=989
CONTROL_PLANE_EDGE_SUBNET=172.28.200.0/24
CADDY_EDGE_IP=172.28.200.2
LITELLM_EDGE_IP=172.28.200.3

# Use two distinct loopback addresses for initial verification. Production
# replaces these with exact Tailscale and LAN addresses. Wildcard IPv4 and
# IPv6 binds are forbidden, and both publications require DOCKER-USER policy.
CONTROL_PLANE_TAILSCALE_BIND_ADDRESS=127.0.0.1
CONTROL_PLANE_LAN_BIND_ADDRESS=127.0.0.2
CONTROL_PLANE_HTTPS_PORT=443
AI_FQDN=ai.home.arpa
AI_LEGACY_FQDN=home-core.invalid
N8N_FQDN=n8n.home.arpa
N8N_UPSTREAM=http://192.168.30.122:15678

# Each image must include an immutable manifest digest. The readable tag is a
# hint only; the digest is the deployed identity. Resolve and review a digest
# for the target amd64 host before install.
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
LITELLM_IMAGE=ghcr.io/berriai/litellm-non_root:v1.99.1@sha256:47ade0259462ec54b18bcc44ff52bba4cee878c0267f8b893070bb79b4dcfbee
POSTGRES_IMAGE=postgres:16.15-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685

# The qualified GB10 text endpoint is reached only by LiteLLM. The API key file
# must contain the same credential as the compute node's text service.
# This deployment's only plain-HTTP exception is the dedicated, non-routed
# 10.77.10.2/24 point-to-point link with source-restricted firewalls at both
# ends. Do not reuse these URLs over the LAN, tailnet, or another routed
# network.
COMPUTE_OPENAI_BASE_URL=http://10.77.10.10:8000/v1
# Staged modality endpoints are tested directly over the private link. Add them
# to LiteLLM and Caddy only in the promotion change after qualification passes.
COMPUTE_API_KEY_FILE=/run/secrets/control-plane/compute-api-key

LITELLM_MASTER_KEY_FILE=/run/secrets/control-plane/litellm-master-key
LITELLM_SALT_KEY_FILE=/run/secrets/control-plane/litellm-salt-key
POSTGRES_ADMIN_PASSWORD_FILE=/run/secrets/control-plane/postgres-admin-password
POSTGRES_APP_PASSWORD_FILE=/run/secrets/control-plane/postgres-app-password

# Changing the salt after virtual keys exist invalidates encrypted data.
# PostgreSQL and Caddy data live below CONTROL_PLANE_STATE_ROOT and must pass an
# off-host backup/restore test before production migration.
