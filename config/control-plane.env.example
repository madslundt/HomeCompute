# Copy to a root-owned, mode-0600 runtime file outside the Git checkout and
# replace every REQUIRED placeholder. sops-nix materializes the secret files.

TIMEZONE=Europe/Copenhagen
CONTROL_PLANE_STATE_ROOT=/srv/state/control-plane
CONTROL_PLANE_SECRET_GID=989
CONTROL_PLANE_EDGE_SUBNET=172.28.200.0/24
CADDY_EDGE_IP=172.28.200.2
LITELLM_EDGE_IP=172.28.200.3

# Use 127.0.0.1 for initial verification. For a LAN address, configure the
# exact Tailscale or LAN address and add its policy to the NixOS firewall.
# Wildcard IPv4 and IPv6 binds are forbidden.
CONTROL_PLANE_BIND_ADDRESS=127.0.0.1
CONTROL_PLANE_HTTPS_PORT=443
AI_FQDN=ai.home.arpa

# Each image must include an immutable manifest digest. The readable tag is a
# hint only; the digest is the deployed identity. Resolve and review a digest
# for the target amd64 host before install.
CADDY_IMAGE=caddy:REPLACE_WITH_REVIEWED_SEMVER-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
LITELLM_IMAGE=ghcr.io/berriai/litellm-non_root:vREPLACE_WITH_REVIEWED_SEMVER@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=postgres:16.REPLACE_WITH_REVIEWED_PATCH-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST

# The GB10 OpenAI-compatible endpoint is reached only by LiteLLM. The API key
# file must contain the same credential as the compute node's vLLM secret.
# Prefer TLS on the compute endpoint. A plain HTTP exception requires a
# dedicated, non-routed point-to-point link/VLAN and a recorded risk decision.
COMPUTE_OPENAI_BASE_URL=https://10.77.10.10:8000/v1
COMPUTE_API_KEY_FILE=/run/secrets/control-plane/compute-api-key

LITELLM_MASTER_KEY_FILE=/run/secrets/control-plane/litellm-master-key
LITELLM_SALT_KEY_FILE=/run/secrets/control-plane/litellm-salt-key
POSTGRES_ADMIN_PASSWORD_FILE=/run/secrets/control-plane/postgres-admin-password
POSTGRES_APP_PASSWORD_FILE=/run/secrets/control-plane/postgres-app-password

# Changing the salt after virtual keys exist invalidates encrypted data.
# PostgreSQL and Caddy data live below CONTROL_PLANE_STATE_ROOT and must pass an
# off-host backup/restore test before production migration.
