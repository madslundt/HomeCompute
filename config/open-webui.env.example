# Copy to a root-owned, mode-0600 runtime file outside the Git checkout.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4@sha256:332438e079ad23bb11b0ab278b43e7c98b50e8cec14b0840281644e8a289f49f
OPEN_WEBUI_STATE_ROOT=/srv/state/open-webui
OPEN_WEBUI_SECRET_GID=989

# These runtime secret files must be provisioned outside Git and readable by
# container supplementary group 989 (root:homecompute-secrets, mode 0440).
# The LiteLLM key must be a dedicated, revocable virtual key limited to the
# approved model group(s), never the master key.
OPEN_WEBUI_LITELLM_API_KEY_FILE=/run/secrets/open-webui/litellm-api-key
OPEN_WEBUI_SECRET_KEY_FILE=/run/secrets/open-webui/webui-secret-key
