# Dedicated fast Home Assistant conversation fallback on home-spark.
# Copy to /etc/gb10-ai/home-assistant-model.env and replace runtime IDs.
VLLM_IMAGE=nvcr.io/nvidia/vllm@sha256:d049bead397430803ac5b705d50094492f23782716677d746ab721e43f054cf6
HOME_DEPLOYMENT_ID=home-spark-primary
HOME_MODEL_ID=google/gemma-4-E4B-it-qat-w4a16-ct
HOME_MODEL_REVISION=6cd26aaa2357fb2bad8c51699a7558a4d1a965bb
HOME_TOKENIZER_REVISION=6cd26aaa2357fb2bad8c51699a7558a4d1a965bb
HOME_CODE_REVISION=6cd26aaa2357fb2bad8c51699a7558a4d1a965bb
HOME_MODEL_LICENSE_ID=apache-2.0
HOME_MODEL_QUANTIZATION=QAT-W4A16
HOME_CHAT_TEMPLATE_SHA256=0a2c8073c878ab1da004bee933a998606537bbb62016310352c7285c3f01c5b5
HOME_ARTIFACT_MAX_BYTES=13000000000
HOME_ARTIFACT_MAX_FILES=16
GB10_ROOT=/srv/gb10-ai
