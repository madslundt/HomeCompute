{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "allowTailscale": false,
      "rateLimit": {
        "maxAttempts": 5,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": false
      }
    },
    "tailscale": {
      "mode": "off"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://localhost:18791",
        "http://127.0.0.1:18791"
      ]
    },
    "terminal": {
      "enabled": false
    },
    "cliAgents": {
      "enabled": false
    },
    "uploads": {
      "enabled": false
    },
    "nodes": {
      "pairing": {
        "autoApproveLocal": false,
        "sshVerify": false
      },
      "commands": {
        "deny": [
          "system.run",
          "system.run.prepare",
          "system.which"
        ]
      }
    },
    "reload": {
      "mode": "off"
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "homecompute": {
        "baseUrl": "http://model-relay:8081/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "OPENCLAW_MODEL_KEY"
        },
        "api": "openai-completions",
        "agentRuntime": {
          "id": "openclaw"
        },
        "timeoutSeconds": 600,
        "request": {
          "proxy": {
            "mode": "env-proxy"
          }
        },
        "models": [
          {
            "id": "automation-moe",
            "name": "HomeCompute automation-moe (qualification required)",
            "input": [
              "text"
            ],
            "contextTokens": 32768,
            "maxTokens": 4096,
            "compat": {
              "supportsDeveloperRole": false,
              "supportsReasoningEffort": false,
              "maxTokensField": "max_tokens"
            },
            "contextWindow": 262144
          }
        ]
      }
    },
    "catalogRefresh": {
      "enabled": false
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "homecompute/automation-moe",
        "fallbacks": []
      },
      "modelPolicy": {
        "allow": [
          "homecompute/automation-moe"
        ]
      },
      "models": {
        "homecompute/automation-moe": {
          "alias": "automation-moe"
        }
      },
      "skills": [],
      "thinkingDefault": "off",
      "maxConcurrent": 1,
      "timeoutSeconds": 660,
      "userTimezone": "Europe/Copenhagen",
      "heartbeat": {
        "every": "0m"
      },
      "embeddedAgent": {
        "projectSettingsPolicy": "ignore",
        "cyberFailover": {
          "mode": "off"
        }
      }
    },
    "entries": {
      "assistant": {
        "name": "HomeCompute assistant"
      }
    }
  },
  "memory": {
    "search": {
      "enabled": true,
      "provider": "none",
      "sources": [
        "memory"
      ],
      "store": {
        "vector": {
          "enabled": false
        }
      },
      "query": {
        "maxResults": 5
      }
    }
  },
  "plugins": {
    "allow": [
      "memory-core",
      "homecompute-broker"
    ],
    "slots": {
      "memory": "memory-core"
    },
    "load": {
      "paths": [
        "/opt/homecompute/broker-plugin"
      ]
    },
    "entries": {
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      },
      "homecompute-broker": {
        "enabled": true,
        "hooks": {
          "allowPromptInjection": false,
          "allowConversationAccess": false
        }
      }
    }
  },
  "mcp": {
    "servers": {}
  },
  "browser": {
    "enabled": false
  },
  "hooks": {
    "enabled": false
  },
  "cron": {
    "enabled": false
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "commands": {
    "config": false,
    "restart": false,
    "bash": false
  },
  "tools": {
    "allow": [
      "session_status",
      "memory_search",
      "memory_get",
      "write",
      "homecompute_task_submit",
      "homecompute_task_status",
      "homecompute_task_cancel"
    ],
    "deny": [
      "group:runtime",
      "edit",
      "apply_patch",
      "group:ui",
      "group:nodes",
      "group:automation",
      "group:web",
      "group:messaging",
      "sessions_spawn",
      "sessions_send",
      "subagents",
      "github_publish"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "mode": "deny"
    },
    "elevated": {
      "enabled": false
    },
    "codeMode": {
      "enabled": false
    },
    "loopDetection": {
      "enabled": true
    },
    "toolSearch": {
      "enabled": false
    }
  },
  "logging": {
    "level": "warn",
    "consoleLevel": "warn",
    "consoleStyle": "json",
    "maxFileBytes": 10485760,
    "audit": {
      "enabled": true,
      "executionIdentity": false,
      "messages": "off"
    }
  },
  "telemetry": {
    "enabled": false
  },
  "env": {
    "shellEnv": {
      "enabled": false
    }
  },
  "update": {
    "checkOnStart": false,
    "auto": {
      "enabled": false
    }
  },
  "acp": {
    "enabled": false,
    "dispatch": {
      "enabled": false
    }
  }
}
