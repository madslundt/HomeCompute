{
  "schema_version": 1,
  "mode": "qualification-only",
  "routes": {
    "stt": {
      "danish": "stt_multilingual",
      "english_mixed_or_unknown": "stt_multilingual"
    },
    "tts": {
      "danish": "tts_danish",
      "english_or_supported_non_danish": "tts_english",
      "danish_gpu_fallback": "tts_danish_fallback",
      "non_danish_gpu_failure": "fail-closed"
    }
  },
  "language_rules": {
    "danish_tags": [
      "da",
      "da-DK"
    ],
    "english_tags": [
      "en",
      "en-GB",
      "en-US"
    ],
    "mixed_or_unknown_tags": [
      "mixed",
      "unknown",
      "und"
    ],
    "qwen_supported_language_tags": [
      "zh",
      "en",
      "ja",
      "ko",
      "de",
      "fr",
      "ru",
      "pt",
      "es",
      "it"
    ],
    "qwen_danish_forbidden": true,
    "tts_supported_language_tags": [
      "da",
      "en"
    ]
  },
  "activation_gates": {
    "all_routes_require_qualification": true,
    "arbitrary_voice_cloning_requires_documented_consent_and-policy": true,
    "omnivoice_voice_policy": "seeded-synthetic-household-voice",
    "omnivoice_noncommercial_household_only": true
  }
}
