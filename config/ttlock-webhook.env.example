# Copy to /etc/homecompute/ttlock-webhook.env with mode 0600. Never use these values.
TTLOCK_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
HA_WEBHOOK_URL=http://homeassistant.local/api/webhook/replace-with-separate-secret
HOME_ASSISTANT_ADDRESS=192.168.30.30
TTLOCK_GATEWAY_PORT=8085
MAX_BODY_BYTES=16384
RATE_LIMIT_PER_MINUTE=30
DEDUPE_TTL_SECONDS=600
HA_TIMEOUT_SECONDS=1
LOG_LEVEL=INFO
