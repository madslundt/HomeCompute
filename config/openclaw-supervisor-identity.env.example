# Write the qualified replacement's exact identity here in the guest.
# Install as /etc/homecompute-openclaw/supervisor-identity.env mode 0600.
# Obtain id from exact scoped OpenShell sandbox metadata; generation from the
# existing scoped NemoClaw registry. Never infer another gateway or sandbox.
OPENCLAW_EXPECTED_SANDBOX_ID=REPLACE_WITH_APPROVED_SANDBOX_UUID
OPENCLAW_EXPECTED_GENERATION=REPLACE_WITH_APPROVED_LIFECYCLE_GENERATION_UUID
