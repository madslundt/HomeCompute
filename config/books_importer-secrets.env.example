# Reference for books_importer/environment in secrets/home-core.sops.yaml.
# Edit the encrypted file with SOPS; never fill or commit credentials here.
# NixOS materializes /run/secrets/books_importer/environment as root with mode 0400.
# Single-quote values to preserve literal dollar signs and hash characters.
HARDCOVER_API_KEY=REPLACE_WITH_VALUE_IN_SOPS
GOODREADS_RSS_URL=REPLACE_WITH_VALUE_IN_SOPS
CWA_USERNAME=REPLACE_WITH_VALUE_IN_SOPS
CWA_PASSWORD=REPLACE_WITH_VALUE_IN_SOPS
SHELFMARK_USERNAME=REPLACE_WITH_VALUE_IN_SOPS
SHELFMARK_PASSWORD=REPLACE_WITH_VALUE_IN_SOPS
