# Secret-free deployment inputs. All services remain opt-in and require approval.
OPENCLAW_STATE_ROOT=/srv/state/openclaw
OPENCLAW_CONFIG_FILE=/etc/homecompute/openclaw/openclaw.json
# Dedicated group able to read only these three secrets; set during operator setup.
OPENCLAW_SECRET_GID=
OPENCLAW_GATEWAY_TOKEN_FILE=/run/secrets/openclaw/gateway_token
OPENCLAW_MODEL_KEY_FILE=/run/secrets/openclaw/model_key
OPENCLAW_BROKER_TOKEN_FILE=/run/secrets/openclaw/broker_token
OPENCLAW_MODEL_CA_FILE=/srv/state/control-plane/caddy-data/caddy/pki/authorities/local/root.crt
OPENCLAW_WORK_ROOT=/srv/state/openclaw-work
CODEX_PROJECTS_FILE=/etc/homecompute/openclaw/projects.json
HOMECOMPUTE_ACTIONS_FILE=/etc/homecompute/openclaw/actions.json
HOMECOMPUTE_MONITORING_FILE=/etc/homecompute/openclaw/monitoring.json
CODEX_WORKER_TOKEN_FILE=/run/secrets/openclaw/worker_token
CODEX_OPERATOR_TOKEN_FILE=/run/secrets/openclaw/operator_token
CODEX_GITHUB_TOKEN_FILE=/run/secrets/openclaw/github_token
CODEX_GITHUB_CHECKOUT_TOKEN_FILE=/run/secrets/openclaw/github_checkout_token
CODEX_API_KEY_FILE=/run/secrets/openclaw/codex_api_key
