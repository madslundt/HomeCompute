{
  "name": "Retired Telegram conversation route \u2014 outbound notifications only",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trusted-existing-telegram-router",
      "name": "Trusted existing Telegram router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "throw new Error('Telegram conversations are retired. Use Mattermost; Telegram is outbound notifications only.');"
      },
      "id": "validate-private-sender-and-command",
      "name": "Validate private sender and command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.adapter_url + '/conversation' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({conversation:$json.conversation,destination:$json.destination,request_id:$json.request_id,text:$json.text}) }}",
        "options": {
          "timeout": 70000
        }
      },
      "id": "conversation-with-durable-request-identity",
      "name": "Conversation with durable request identity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "OpenClaw dedicated conversation transport (select after approval)"
        }
      },
      "retryOnFail": false,
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "if (!['completed','running','uncertain'].includes($json.state)) throw new Error('Unexpected conversation receipt'); return [{json:{state:$json.state,delivery:$json.state==='completed'?'queued_in_durable_outbox':'requires_status_or_reconciliation'}}];"
      },
      "id": "return-processing-status",
      "name": "Return processing status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Copenhagen",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  },
  "pinData": {},
  "tags": []
}
