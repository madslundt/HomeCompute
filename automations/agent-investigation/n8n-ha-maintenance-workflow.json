    {
      "name": "Verify update baseline",
      "id": "ha-maintenance-3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "const r=$('Validate maintenance request').first().json.request, rows=$input.all();\nif(rows.length!==1)throw Error('Exactly one selected update required');\nconst e=rows[0].json,a=e.attributes||{},version=x=>typeof x==='string'&&/^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$/.test(x);\nif(e.entity_id!==r.entity_id||!['on','off'].includes(e.state)||!version(a.installed_version)||!version(a.latest_version)||!Number.isInteger(a.supported_features)||a.supported_features<0||a.supported_features>65535||typeof a.in_progress!=='boolean')throw Error('Update metadata unavailable');\nconst snapshot={schema_version:1,entity_id:e.entity_id,state:e.state,installed_version:a.installed_version,latest_version:a.latest_version,supported_features:a.supported_features,in_progress:a.in_progress,observed_at:Date.now()/1000};\nif(r.operation==='execute'&&(snapshot.installed_version!==r.expected_installed||snapshot.latest_version!==r.version||snapshot.state!=='on'||snapshot.in_progress||(snapshot.supported_features&11)!==11||r.backup!==true))throw Error('Update candidate or capability changed; review required');\nreturn [{json:{request:r,snapshot}}];"
      }
    },
