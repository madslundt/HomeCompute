      "parameters": {
        "jsCode": "const configured=false;\nif(!configured)throw Error('Trusted maintenance setup required');\nconst object=x=>x&&typeof x==='object'&&!Array.isArray(x), exact=(x,ks)=>object(x)&&Object.keys(x).sort().join(',')===ks.slice().sort().join(','), version=x=>typeof x==='string'&&/^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$/.test(x);\nif($input.all().length!==1||Object.keys($json.query||{}).length||Object.keys($json.params||{}).length)throw Error('Input selectors prohibited');\nconst r=$json.body, allowed=[\"update.home_assistant_core_update\", \"update.home_assistant_supervisor_update\", \"update.home_assistant_operating_system_update\", \"update.house_battery_update\", \"update.stromligning_update\", \"update.watts_live_update\"];\nif(!object(r)||!['snapshot','execute'].includes(r.operation)||!exact(r,r.operation==='snapshot'?['operation','entity_id']:['operation','entity_id','version','expected_installed','backup'])||!allowed.includes(r.entity_id))throw Error('Exact finite update request required');\nif(r.operation==='execute'&&(!version(r.version)||!version(r.expected_installed)||r.version===r.expected_installed||r.backup!==true))throw Error('Exact candidate, baseline and backup required');\nreturn [{json:{request:r}}];"
