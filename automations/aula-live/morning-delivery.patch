+function morningActionDetail(fact) {
+  const detail = childSafeText(fact?.detail, fact?.child).trim();
+  if (/hele dagen udenfor|udedag/i.test(detail) && /tøj efter vejret/i.test(detail) && /ekstra trøje/i.test(detail)) {
+    return 'Tøj efter vejret til hele dagen udenfor; ekstra trøje med';
+  }
+  const sentences = detail.split(/(?<=[.!?])\s+/).map(part => part.replace(/[.!?]+$/, '').trim());
+  const actions = sentences.filter(part => /\bhusk\b|medbring|skal\s+have|tag\s+.*\s+med|tøj efter vejret|ekstra\s+trøje|fjern.*(?:ørering|smykke)/i.test(part));
+  return actions.slice(0, 2).map(part => part.replace(/^(?:så\s+|det vil sige\s+)/i, '')).join('; ');
+}
