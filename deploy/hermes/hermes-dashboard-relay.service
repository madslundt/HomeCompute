# HomeCompute-managed authenticated Hermes dashboard relay
[Unit]
Description=Private ingress for the authenticated Hermes dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=hermes-operator
Group=hermes-operator
ExecStart=/usr/bin/socat TCP4-LISTEN:18804,bind=10.77.20.2,reuseaddr,fork TCP4:127.0.0.1:8646
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
