# HomeCompute-managed authenticated Hermes dashboard relay
[Unit]
Description=Private ingress for the authenticated Hermes dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=hermes-operator
Group=hermes-operator
ExecStart=/usr/bin/python3 @RELAY@ --target-port @PORT@
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
