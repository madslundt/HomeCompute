# Managed Hermes 0.23 overlay; selection is owned by config/hermes-release.json.
# Retain the complete OpenShell/NemoClaw runtime, identities and supervisor.
FROM ghcr.io/nvidia/nemoclaw/hermes-sandbox@sha256:f52d55af05b63302ca8ae54ca9141b80df433a72ce273ae4aeac08c5af2cb990
USER root
ARG NEMOCLAW_CORPORATE_CA_B64=
RUN if [ -n "$NEMOCLAW_CORPORATE_CA_B64" ]; then \
      printf '%s' "$NEMOCLAW_CORPORATE_CA_B64" | base64 --decode > /usr/local/share/nemoclaw/corporate-ca.pem \
      && openssl crl2pkcs7 -nocrl -certfile /usr/local/share/nemoclaw/corporate-ca.pem > /dev/null \
      && cp /usr/local/share/nemoclaw/corporate-ca.pem /usr/local/share/ca-certificates/homecompute.crt \
      && chmod 0444 /usr/local/share/nemoclaw/corporate-ca.pem /usr/local/share/ca-certificates/homecompute.crt \
      && update-ca-certificates; \
    fi
ADD --checksum=sha256:0250ce85c071ebceefc5b9d1b58a7a52f71d2849a6ef1d0a70af07d108ef08dc https://codeload.github.com/NousResearch/hermes-agent/tar.gz/2bd378ed1b8d6bf2192cb26e0a55ff3091e6bd19 /tmp/hermes-latest.tar.gz
ADD --checksum=sha256:dfa4c5a40c47f338f41658017be550c72247c391e6bfb1fa4da03ebc8451abdf https://github.com/astral-sh/python-build-standalone/releases/download/20261021/cpython-3.14.9+20261021-x86_64-unknown-linux-gnu-install_only.tar.gz /tmp/hermes-python.tar.gz
# Node 26 requires this exact runtime library; do not invoke an unpinned apt repair.
ADD --checksum=sha256:212b399aae2f7299203d261a57e49372e09565a9a5ea971905f94a3960366c05 https://deb.debian.org/debian/pool/main/g/gcc-14/libatomic1_14.2.0-19_amd64.deb /tmp/hermes-libatomic.deb
RUN dpkg -i /tmp/hermes-libatomic.deb && rm /tmp/hermes-libatomic.deb
COPY latest/managed-integration.patch /tmp/homecompute-managed-integration.patch
RUN mkdir -p /tmp/hermes-latest/python-runtime \
    && tar -xzf /tmp/hermes-latest.tar.gz --strip-components=1 -C /tmp/hermes-latest \
    && tar -xzf /tmp/hermes-python.tar.gz --strip-components=1 -C /tmp/hermes-latest/python-runtime \
    && git -C /tmp/hermes-latest apply --check /tmp/homecompute-managed-integration.patch \
    && git -C /tmp/hermes-latest apply /tmp/homecompute-managed-integration.patch \
    && rm -rf /opt/hermes \
    && mv /tmp/hermes-latest /opt/hermes \
    && cp -a /opt/nemoclaw-hermes-plugin /opt/hermes/plugins/nemoclaw \
    && rm /tmp/hermes-latest.tar.gz /tmp/hermes-python.tar.gz /tmp/homecompute-managed-integration.patch
WORKDIR /opt/hermes
ENV HERMES_RUNTIME_DIR=/opt/hermes/tools
# Use the release's package manager and frozen lock, including the one exact
# PyYAML compatibility extra needed by the retained managed plugin.
RUN HERMES_HOME=/tmp/hermes-build /opt/hermes/python-runtime/bin/python3 -m pm.build_env \
      --source /opt/hermes --python /opt/hermes/python-runtime/bin/python3 \
      --out /opt/hermes/.venv --sealed --record-selection \
      --extra nemoclaw --extra messaging --extra web --extra mcp --extra acp --extra anthropic \
    && chmod -R a+rX /opt/hermes/.venv /opt/hermes/python-runtime \
    && rm -rf /tmp/hermes-build /root/.cache/uv
# The new release seals dependency environments and binds source through its
# offline assembler. A raw editable install has no usable source import path.
RUN /opt/hermes/python-runtime/bin/python3 -c 'from pathlib import Path; from pm import stage_manager_runtime; from scripts.bundles.payload import seal_pm_runtime; root=Path("/opt/hermes"); python=Path("/opt/hermes/python-runtime/bin/python3").resolve(); stage_manager_runtime(python=python, destination=root/"pm-runtime", project=root/"pm"); seal_pm_runtime(root, python)'
RUN /opt/hermes/python-runtime/bin/python3 scripts/write_install_stamp.py \
      --output /opt/hermes/install-stamp.json --commit 2bd378ed1b8d6bf2192cb26e0a55ff3091e6bd19 \
      --base-version 0.23.0 --distance 0 --dirty --source homecompute --distribution docker --update-mechanism external \
    && /opt/hermes/python-runtime/bin/python3 -c 'import json; from pathlib import Path; p=Path("/opt/hermes/install-stamp.json"); d=json.loads(p.read_text()); d["pmRuntime"]="/opt/hermes/pm-runtime"; p.write_text(json.dumps(d)+"\n")'
RUN /opt/hermes/python-runtime/bin/python3 -c 'from pm import ensure; ensure("npm", explicit=True)'
RUN hermes_node_dir="$(/opt/hermes/python-runtime/bin/python3 -c 'from pm import installed_package; print(installed_package("node").binary.parent)')" \
    && hermes_npm_cli="$(/opt/hermes/python-runtime/bin/python3 -c 'from pm import installed_package; print(installed_package("npm").binary.parent.parent/"lib/node_modules/npm/bin/npm-cli.js")')" \
    && export PATH="$hermes_node_dir:$PATH" npm_execpath="$hermes_npm_cli" \
    && test "$(node --version)" = v26.12.1 \
    && test "$(node "$npm_execpath" --version)" = 12.0.2 \
    && node scripts/build/node-deps.mjs --source /opt/hermes --workspace ui-tui --workspace web \
    && /opt/hermes/.venv/bin/python scripts/generate_icons.py --source /opt/hermes --out /tmp/hermes-icons \
    && node scripts/build/tui.mjs --source /opt/hermes --out /opt/products/tui \
    && node scripts/build/web.mjs --source /opt/hermes --icons /tmp/hermes-icons --out /opt/products/web \
    && cp -a /opt/products/tui/. /opt/hermes/ui-tui/ \
    && mkdir -p /opt/hermes/hermes_cli/web_dist \
    && cp -a /opt/products/web/. /opt/hermes/hermes_cli/web_dist/ \
    && mkdir /tmp/hermes-console-entries \
    && cp /opt/hermes/.venv/bin/hermes /opt/hermes/.venv/bin/hermes-agent /opt/hermes/.venv/bin/hermes-acp /tmp/hermes-console-entries/ \
    && /opt/hermes/.venv/bin/python -m docker.build_agent \
    && rm /opt/hermes/.venv/bin/hermes /opt/hermes/.venv/bin/hermes-agent /opt/hermes/.venv/bin/hermes-acp \
    && cp /tmp/hermes-console-entries/* /opt/hermes/.venv/bin/ \
    && rm -r /tmp/hermes-console-entries \
    && find /opt/hermes -type d ! -perm -0005 -exec chmod a+rX {} + \
    && find /opt/hermes -type f \( ! -perm -0004 -o \( -perm /111 ! -perm -0001 \) \) -exec chmod a+rX {} + \
    && rm -rf /opt/products /tmp/hermes-icons /root/.npm /root/.cache/uv
# Validate the retained managed CLI adapter against the real new parser. A
# version string alone does not establish compatibility.
RUN python3 -c 'import json; p="/usr/local/share/nemoclaw/hermes-cli-adapter-v1.json"; d=json.load(open(p)); assert d["upstream_cli_version"] == "0.21.3"; d["upstream_cli_version"]="0.23.0"; open(p,"w").write(json.dumps(d)+"\n")' \
    && /opt/hermes/.venv/bin/python -I /usr/local/lib/nemoclaw/validate-hermes-cli-adapter.py \
      --contract /usr/local/share/nemoclaw/hermes-cli-adapter-v1.json --hermes /opt/hermes/.venv/bin/hermes \
    && /usr/local/bin/hermes --version
COPY latest/probe_runtime.py /usr/local/lib/nemoclaw/homecompute-hermes-latest-probe.py
RUN chmod 0444 /usr/local/lib/nemoclaw/homecompute-hermes-latest-probe.py \
    && HOME=/sandbox /usr/bin/setpriv --reuid=sandbox --regid=sandbox --init-groups -- /opt/hermes/.venv/bin/python -I /usr/local/lib/nemoclaw/homecompute-hermes-latest-probe.py
# Run upstream transport and ownership regressions on Linux. Test dependencies
# live only in this temporary build environment, never the shipped runtime.
RUN HERMES_HOME=/tmp/homecompute-hermes-test-build /opt/hermes/python-runtime/bin/python3 -m pm.build_env \
      --source /opt/hermes --python /opt/hermes/python-runtime/bin/python3 \
      --out /tmp/homecompute-hermes-test-env --sealed --no-install-project --group dev \
      --extra nemoclaw --extra messaging --extra web --extra mcp --extra acp --extra anthropic \
    && env -u HERMES_HOME PYTHONDONTWRITEBYTECODE=1 \
      /tmp/homecompute-hermes-test-env/bin/python -m pytest -q \
      tests/gateway/test_mattermost.py \
      tests/tools/test_browser_use_cli.py tests/tools/test_browser_use_cli_owned_daemon.py \
      tests/gateway/test_runtime_ownership.py tests/gateway/test_control_socket.py \
      tests/gateway/test_control_socket_peer_security.py tests/hermes_cli/test_gateway_runtime_discovery.py \
      tests/gateway/test_session_authorities_multiplex.py tests/gateway/test_session_authority.py \
      tests/gateway/test_session_policy.py tests/gateway/test_session_group_controls.py \
      tests/gateway/test_session_mutation_model.py \
    && rm -rf /tmp/homecompute-hermes-test-build /tmp/homecompute-hermes-test-env \
      /tmp/homecompute-hermes-test-home /opt/hermes/.pytest_cache /root/.cache/uv
# Required PM tools must ship in this externally managed artifact. Runtime
# install drift cannot repair a sealed image, even when browsing itself works.
RUN /opt/hermes/python-runtime/bin/python3 -c 'from pathlib import Path; from pm import prepare_tools; from pm.store import current_target; prepare_tools(["ffmpeg", "ripgrep"], out=Path("/opt/hermes/tools"), target=current_target())' \
    && find /opt/hermes/tools -type d ! -perm -0005 -exec chmod a+rX {} + \
    && find /opt/hermes/tools -type f \( ! -perm -0004 -o \( -perm /111 ! -perm -0001 \) \) -exec chmod a+rX {} + \
    && HOME=/sandbox /usr/bin/setpriv --reuid=sandbox --regid=sandbox --init-groups -- /opt/hermes/.venv/bin/python -I -c 'import pm; problems=pm.check(); assert not problems, problems'
COPY browser-relay.mjs /usr/local/lib/nemoclaw/browser-relay.mjs
RUN chmod 0444 /usr/local/lib/nemoclaw/browser-relay.mjs
ENV HERMES_DUMP_REQUESTS=0 HERMES_DUMP_REQUEST_STDOUT=0 \
    NEMOCLAW_CONTEXT_WINDOW=65536 \
    NEMOCLAW_INFERENCE_PROVIDER_ID=compatible-endpoint \
    NEMOCLAW_MODEL=automation-moe \
    NEMOCLAW_INFERENCE_BASE_URL=http://ai.home.arpa:18080/v1 \
    NEMOCLAW_PROVIDER_KEY=compatible-endpoint \
    NEMOCLAW_UPSTREAM_PROVIDER=compatible-endpoint \
    NEMOCLAW_INFERENCE_API=openai-completions
ARG NEMOCLAW_TOOL_DISCLOSURE=progressive
ENV NEMOCLAW_TOOL_DISCLOSURE=${NEMOCLAW_TOOL_DISCLOSURE}
RUN HOME=/sandbox node /opt/nemoclaw-hermes-config/generate-config.ts \
    && install -o root -g root -m 0444 /sandbox/.hermes/managed-policy.json /usr/local/share/nemoclaw/hermes-managed-policy.json \
    && rm /sandbox/.hermes/managed-policy.json \
    && chown sandbox:sandbox /sandbox/.hermes/config.yaml /sandbox/.hermes/.env \
    && chmod 0640 /sandbox/.hermes/config.yaml /sandbox/.hermes/.env
WORKDIR /sandbox
USER sandbox
