diff --git a/gateway/homecompute_paths.py b/gateway/homecompute_paths.py
new file mode 100644
index 00000000..d288bd6f
--- /dev/null
+++ b/gateway/homecompute_paths.py
@@ -0,0 +1,44 @@
+"""Managed runtime artifacts without changing the logical Hermes profile home."""
+from pathlib import Path
+import os
+import stat
+
+MANAGED_HOME = Path('/sandbox/.hermes')
+
+
+def state_path(home: Path, name: str) -> Path:
+    home = Path(home)
+    if home == MANAGED_HOME and name in {'gateway.pid', 'gateway.lock', 'gateway_state.json'}:
+        return home / 'runtime' / name
+    return home / name
+
+
+def control_home(home: Path) -> Path:
+    home = Path(home)
+    return home / 'runtime' / 'control' if home == MANAGED_HOME else home
+
+
+def prepare_control_home(home: Path) -> Path:
+    directory = control_home(home)
+    if directory != Path(home):
+        directory.mkdir(mode=0o700, exist_ok=True)
+        info = directory.lstat()
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
+            raise PermissionError('unsafe managed control directory')
+    return directory
+
+
+def database_home(db_path: Path, *, mode: str = 'resolved') -> Path:
+    """Recognize only the declared managed state.db alias; retain other homes' semantics."""
+    path = Path(db_path)
+    alias, target = MANAGED_HOME / 'state.db', MANAGED_HOME / 'runtime/state.db'
+    if (path in (alias, target) and alias.is_symlink()
+            and alias.readlink() == Path('runtime/state.db') and path.resolve() == target):
+        return MANAGED_HOME
+    if mode == 'literal':
+        return path.parent
+    if mode == 'parent':
+        return path.parent.resolve()
+    if mode != 'resolved':
+        raise ValueError('unknown database-home resolution mode')
+    return path.resolve().parent
