@@ -174,0 +175,30 @@ function untilAborted<T>(work: Promise<T>, signal: AbortSignal): Promise<T> {
+const hermesTools = new Set([
+  'apps',
+  'manage_apps',
+  'browser',
+  'browser_session',
+  'sign_in',
+  'ask_user',
+  'send_message',
+]);
+
+export function allowsHermesTool(name: string, params?: unknown) {
+  if (!hermesTools.has(name) && !name.startsWith('mcp__')) return false;
+  if (!params || typeof params !== 'object') return true;
+  const input = params as Record<string, unknown>;
+  if (name === 'manage_apps') return input.action === 'list';
+  if (name === 'browser_session') return input.action === 'use';
+  if (name === 'browser')
+    return !['download', 'upload', 'share_screenshot'].includes(String(input.action));
+  if (name === 'send_message') {
+    return (
+      input.intent === 'final' &&
+      input.presentation === undefined &&
+      input.replyToMessageId === undefined &&
+      typeof input.text === 'string' &&
+      input.text.trim().length > 0
+    );
+  }
+  return true;
+}
