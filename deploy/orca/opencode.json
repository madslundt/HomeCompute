{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "model": "homecompute/automation-moe",
  "small_model": "homecompute/automation-moe",
  "providers": {
    "homecompute": {
      "name": "HomeCompute LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "local",
        "baseURL": "http://orca-gateway:18080/v1",
        "encoding": "none",
        "headerTimeout": 600000,
        "chunkTimeout": false
      },
      "models": {
        "automation-moe": {
          "name": "HomeCompute local project and coding model",
          "body": {
            "reasoning_effort": "medium",
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "tool_call": true,
          "reasoning": true
        }
      }
    },
    "homecompute-deep": {
      "name": "HomeCompute queued deep work",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "local",
        "baseURL": "http://orca-gateway:18081/v1",
        "encoding": "none",
        "headerTimeout": 360000,
        "chunkTimeout": 180000
      },
      "models": {
        "automation-moe": {
          "name": "HomeCompute deep coding model (one request at a time)",
          "body": {
            "reasoning_effort": "xhigh",
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/etc/homecompute-orca/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/etc/homecompute-orca/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "orca-project-status *",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "mcp": {}
}
