+import { chmod, mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { delimiter, join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { afterEach, expect, test } from 'bun:test';
+import { extractAttachmentText } from './attachment-text.ts';
+
+const directories: string[] = [];
+const originalPath = process.env.PATH;
+
+afterEach(async () => {
+  if (originalPath === undefined) delete process.env.PATH;
+  else process.env.PATH = originalPath;
+  await Promise.all(directories.splice(0).map((directory) => rm(directory, { recursive: true, force: true })));
+});
+
+test('extracts legacy Word, Excel and PowerPoint through the allow-listed converters', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'aula-legacy-office-'));
+  directories.push(root);
+  const bin = join(root, 'bin');
+  const files = join(root, 'files');
+  await mkdir(bin);
+  await mkdir(files);
+  for (const [command, output] of Object.entries({
+    catdoc: 'Legacy Word text',
+    xls2csv: 'Legacy,Spreadsheet',
+    catppt: 'Legacy PowerPoint text',
+  })) {
+    const executable = join(bin, command);
+    await writeFile(executable, `#!/bin/sh\nprintf '%s\\n' '${output}'\n`);
+    await chmod(executable, 0o755);
+  }
+  process.env.PATH = `${bin}${delimiter}${originalPath ?? ''}`;
+  const fixtures = [
+    ['plan.doc', 'Legacy Word text'],
+    ['budget.xls', 'Legacy,Spreadsheet'],
+    ['slides.ppt', 'Legacy PowerPoint text'],
+  ] as const;
+  for (const [filename, expected] of fixtures) {
+    const path = join(files, filename);
+    await writeFile(path, 'synthetic fixture');
+    const result = await extractAttachmentText(path);
+    expect(result.format).toBe(filename.split('.').at(-1));
+    expect(result.text).toBe(expected);
+  }
+});
