@@ -0,0 +1,156 @@
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import { inflateRawSync } from 'node:zlib';
+import { readFile } from 'node:fs/promises';
+import { basename, extname } from 'node:path';
+
+const MAX_UNCOMPRESSED_BYTES = 64 * 1024 * 1024;
+const execFileAsync = promisify(execFile);
+const ZIP_EOCD = 0x06054b50;
+const ZIP_CENTRAL = 0x02014b50;
+const ZIP_LOCAL = 0x04034b50;
+
+function cleanText(value: string): string {
+  return value.replace(/\u0000/g, '').replace(/\r\n?/g, '\n').trim();
+}
+
+function decodeXml(value: string): string {
+  return value
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&apos;/g, "'")
+    .replace(/&amp;/g, '&')
+    .replace(/&#(\d+);/g, (_match, decimal: string) => String.fromCodePoint(Number(decimal)))
+    .replace(/&#x([0-9a-f]+);/gi, (_match, hex: string) => String.fromCodePoint(Number.parseInt(hex, 16)));
+}
+
+function xmlText(xml: string): string {
+  return cleanText(decodeXml(xml
+    .replace(/<\/(?:w:p|a:p|text:p|text:h|p|h)\s*>/g, '\n')
+    .replace(/<w:tab\b[^>]*\/>/g, '\t')
+    .replace(/<w:br\b[^>]*\/>/g, '\n')
+    .replace(/<[^>]+>/g, ' ')
+    .replace(/[\t ]+/g, ' ')
+    .replace(/ *\n */g, '\n')));
+}
+
+function zipEntries(buffer: Buffer): Map<string, Buffer> {
+  const start = Math.max(0, buffer.length - 65_557);
+  let eocd = -1;
+  for (let i = buffer.length - 22; i >= start; i -= 1) {
+    if (buffer.readUInt32LE(i) === ZIP_EOCD) { eocd = i; break; }
+  }
+  if (eocd < 0) throw new Error('Invalid office archive');
+  const entryCount = buffer.readUInt16LE(eocd + 10);
+  const centralOffset = buffer.readUInt32LE(eocd + 16);
+  const result = new Map<string, Buffer>();
+  let offset = centralOffset;
+  let expanded = 0;
+  let actualExpanded = 0;
+  for (let i = 0; i < entryCount; i += 1) {
+    if (offset + 46 > buffer.length || buffer.readUInt32LE(offset) !== ZIP_CENTRAL) throw new Error('Invalid office archive');
+    const method = buffer.readUInt16LE(offset + 10);
+    const compressedSize = buffer.readUInt32LE(offset + 20);
+    const uncompressedSize = buffer.readUInt32LE(offset + 24);
+    const nameLength = buffer.readUInt16LE(offset + 28);
+    const extraLength = buffer.readUInt16LE(offset + 30);
+    const commentLength = buffer.readUInt16LE(offset + 32);
+    const localOffset = buffer.readUInt32LE(offset + 42);
+    const name = buffer.toString('utf8', offset + 46, offset + 46 + nameLength);
+    offset += 46 + nameLength + extraLength + commentLength;
+    if (!name || name.startsWith('/') || name.split('/').includes('..')) continue;
+    if (!/(?:word\/|xl\/|ppt\/|content\.xml$)/.test(name)) continue;
+    expanded += uncompressedSize;
+    if (expanded > MAX_UNCOMPRESSED_BYTES) throw new Error('Office document expands beyond the extraction limit');
+    if (localOffset + 30 > buffer.length || buffer.readUInt32LE(localOffset) !== ZIP_LOCAL) throw new Error('Invalid office archive');
+    const localNameLength = buffer.readUInt16LE(localOffset + 26);
+    const localExtraLength = buffer.readUInt16LE(localOffset + 28);
+    const dataStart = localOffset + 30 + localNameLength + localExtraLength;
+    const dataEnd = dataStart + compressedSize;
+    if (dataEnd > buffer.length) throw new Error('Invalid office archive');
+    const compressed = buffer.subarray(dataStart, dataEnd);
+    const data = method === 0 ? compressed : method === 8 ? inflateRawSync(compressed, { maxOutputLength: MAX_UNCOMPRESSED_BYTES }) : null;
+    if (!data) throw new Error('Unsupported office compression');
+    actualExpanded += data.byteLength;
+    if (actualExpanded > MAX_UNCOMPRESSED_BYTES) throw new Error('Office document expands beyond the extraction limit');
+    result.set(name, data);
+  }
+  return result;
+}
+
+function officeText(filename: string, entries: Map<string, Buffer>): string {
+  const extension = extname(filename).toLowerCase();
+  const xml = (name: string) => entries.get(name)?.toString('utf8') ?? '';
+  if (['.docx', '.docm', '.dotx'].includes(extension)) {
+    const files = [...entries.keys()].filter((name) => /^word\/(?:document|header\d+|footer\d+|footnotes|endnotes)\.xml$/.test(name)).sort();
+    return cleanText(files.map((name) => xmlText(xml(name))).filter(Boolean).join('\n\n'));
+  }
+  if (['.pptx', '.pptm', '.ppsx'].includes(extension)) {
+    const files = [...entries.keys()].filter((name) => /^ppt\/slides\/slide\d+\.xml$/.test(name))
+      .sort((a, b) => Number(a.match(/slide(\d+)/)?.[1]) - Number(b.match(/slide(\d+)/)?.[1]));
+    return cleanText(files.map((name) => xmlText(xml(name))).filter(Boolean).join('\n\n'));
+  }
+  if (['.xlsx', '.xlsm', '.xltx'].includes(extension)) {
+    const shared = [...xml('xl/sharedStrings.xml').matchAll(/<si\b[^>]*>([\s\S]*?)<\/si>/g)]
+      .map((match) => xmlText(match[1]));
+    const files = [...entries.keys()].filter((name) => /^xl\/worksheets\/sheet\d+\.xml$/.test(name))
+      .sort((a, b) => Number(a.match(/sheet(\d+)/)?.[1]) - Number(b.match(/sheet(\d+)/)?.[1]));
+    return cleanText(files.map((name) => {
+      const sheet = xml(name);
+      const rows = [...sheet.matchAll(/<row\b[^>]*>([\s\S]*?)<\/row>/g)].map((row) => {
+        const cells = [...row[1].matchAll(/<c\b([^>]*)>([\s\S]*?)<\/c>/g)].map((cell) => {
+          const index = cell[2].match(/<v>(\d+)<\/v>/)?.[1];
+          const inline = cell[2].match(/<is\b[^>]*>([\s\S]*?)<\/is>/)?.[1];
+          const value = cell[2].match(/<v>([\s\S]*?)<\/v>/)?.[1];
+          return cell[1].includes('t="s"') && index !== undefined ? shared[Number(index)] ?? ''
+            : inline ? xmlText(inline) : value ? decodeXml(value) : '';
+        });
+        return cells.filter(Boolean).join('\t');
+      });
+      return rows.filter(Boolean).join('\n');
+    }).filter(Boolean).join('\n\n'));
+  }
+  if (['.odt', '.ods', '.odp'].includes(extension)) return xmlText(xml('content.xml'));
+  throw new Error('Unsupported office format');
+}
+
+export async function extractAttachmentText(path: string): Promise<{ text: string; format: string }> {
+  const filename = basename(path);
+  const extension = extname(filename).toLowerCase();
+  const bytes = await readFile(path);
+  let text: string;
+  const legacyExtractor: Record<string, string> = {
+    '.doc': 'catdoc', '.dot': 'catdoc',
+    '.xls': 'xls2csv', '.xlt': 'xls2csv',
+    '.ppt': 'catppt', '.pps': 'catppt', '.pot': 'catppt',
+  };
+  const legacyCommand = legacyExtractor[extension];
+  if (legacyCommand) {
+    const result = await execFileAsync(legacyCommand, [path], {
+      timeout: 30_000, maxBuffer: MAX_UNCOMPRESSED_BYTES,
+    });
+    text = result.stdout;
+  } else if (['.docx', '.docm', '.dotx', '.xlsx', '.xlsm', '.xltx', '.pptx', '.pptm', '.ppsx', '.odt', '.ods', '.odp'].includes(extension)) {
+    text = officeText(filename, zipEntries(bytes));
+  } else if (['.png', '.jpg', '.jpeg', '.tif', '.tiff', '.bmp', '.gif', '.webp'].includes(extension)) {
+    const result = await execFileAsync('tesseract', [path, 'stdout', '-l', 'dan+eng', '--psm', '3'], {
+      timeout: 30_000, maxBuffer: 2 * 1024 * 1024,
+    });
+    text = result.stdout;
+  } else if (['.txt', '.text', '.csv', '.tsv', '.md', '.markdown', '.json', '.yaml', '.yml', '.log', '.ics', '.svg', '.xml', '.html', '.htm', '.rtf'].includes(extension)) {
+    text = bytes.toString('utf8');
+    if (extension === '.html' || extension === '.htm') text = xmlText(text.replace(/<script\b[^>]*>[\s\S]*?<\/script\s*>/gi, ' ').replace(/<style\b[^>]*>[\s\S]*?<\/style\s*>/gi, ' '));
+    if (extension === '.rtf') text = text.replace(/\\'[0-9a-f]{2}/gi, ' ').replace(/\\[a-z]+-?\d* ?/gi, ' ').replace(/[{}]/g, ' ');
+  } else if (extension === '.pdf') {
+    const { PDFParse } = (await import('pdf-parse')) as unknown as {
+      PDFParse: new (opts: { data: Buffer }) => { getText(): Promise<{ text: string }>; destroy?(): Promise<void> };
+    };
+    const parser = new PDFParse({ data: bytes });
+    try { text = (await parser.getText()).text; }
+    finally { if (parser.destroy) await parser.destroy(); }
+  } else {
+    throw new Error(`Unsupported attachment format: ${extension || 'unknown'}`);
+  }
+  return { text: cleanText(text), format: extension.slice(1) || 'unknown' };
+}
