{
	admin off
	auto_https disable_redirects
	https_port {$CADDY_HTTPS_PORT}
	servers {
		protocols h1 h2
	}
}

(litellm_proxy) {
	reverse_proxy litellm:4000 {
		health_uri /health/liveliness
		health_interval 30s
		lb_try_duration 5s
		transport http {
			dial_timeout 3s
			response_header_timeout 10m
		}
	}
}

{$AI_FQDN} {
	tls internal
	encode zstd gzip

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	@models {
		method GET
		path /v1/models
	}
	handle @models {
		request_body {
			max_size 32MB
		}
		import litellm_proxy
	}

	@standard {
		method POST
		path /v1/responses /v1/chat/completions
	}
	handle @standard {
		request_body {
			max_size 32MB
		}
		import litellm_proxy
	}

	respond 404

	log {
		output stdout
		format filter {
			request>uri delete
			request>headers delete
		}
	}
}
