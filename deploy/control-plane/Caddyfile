agents.home.arpa {
	tls internal
	encode zstd gzip
	@private remote_ip 192.168.30.0/24 192.168.10.0/24 100.64.0.0/10
	handle @private {
		# Limit Hermes API requests to the Home Assistant host and the endpoints
		# used by the vendored conversation integration.
		@hermesApi {
			remote_ip 192.168.30.30
			path /p/default/v1/models /p/default/v1/chat/completions /p/hermes-conversation-probe-does-not-exist/v1/models
		}
		handle @hermesApi {
			reverse_proxy 172.28.200.1:18805 {
				transport http {
					max_conns_per_host 8
					keepalive off
					dial_timeout 3s
					response_header_timeout 10m
				}
			}
		}
		redir /hermes /hermes/ 308
		# Vite's lazy preloads use root-relative hashed script/style URLs.
		# Return only those chunks to Hermes.
		@hermesPreload path_regexp hermes_preload ^/assets/[A-Za-z0-9_-]+-[A-Za-z0-9_-]{8}\.(js|css)$
		redir @hermesPreload /hermes{uri} 308
		handle_path /hermes/* {
			# Hermes retains its native password, CSRF and WebSocket gates.
			reverse_proxy 172.28.200.1:18805 {
				header_up X-Forwarded-Prefix /hermes
				transport http {
					# Reserve native tunnel slots for chat, speech and operator access.
					max_conns_per_host 8
					# Avoid stale sockets across the native forwarding chain.
					keepalive off
					dial_timeout 3s
					response_header_timeout 10m
				}
			}
		}
		handle {
			respond "Not found" 404
		}
	}
	respond "Forbidden" 403
}

