(model_controls_page) {
	handle /control/ {
		root * /config/model-controls
		rewrite * /index.html
		header Cache-Control no-store
		file_server
	}
}

# Both entry points share the same local-only Spark forwards. The HTTP
# listener is reached only by private Tailscale Serve on the Docker bridge.
(comfyui_studio) {
	encode zstd gzip
	import model_controls_page
	redir /control /control/ 308
	@control_activity {
		method GET
		path /control/api/activity
	}
	handle @control_activity {
		rewrite * /llm/activity
		reverse_proxy 172.28.200.1:18190
	}
	@controls path /control/*
	handle @controls {
		reverse_proxy 172.28.200.1:18189
	}
	@starter_workflow path /api/workflow_templates/homecompute/qwen-image-edit-2511-scottzilla-nsfw.json
	handle @starter_workflow {
		rewrite * /api/userdata/workflows%252Fqwen-image-edit-2511-scottzilla-nsfw.json
		reverse_proxy 172.28.200.1:18188
	}
	@chat_image_submission {
		method POST
		path /prompt /api/prompt
		remote_ip {$OPEN_WEBUI_CLIENT_IP:172.28.210.5}
	}
	handle @chat_image_submission {
		# The fixed image-chat backends have no browser Origin header.
		reverse_proxy 172.28.200.1:18189 {
			header_up Origin https://comfyui.home.arpa
		}
	}
	@image_submission {
		method POST
		path /prompt /api/prompt
	}
	handle @image_submission {
		# Serialize queue admission with stop/idle expiry on the Spark.
		reverse_proxy 172.28.200.1:18189
	}
	handle {
		reverse_proxy 172.28.200.1:18188 {
			transport http {
				dial_timeout 3s
				response_header_timeout 10m
			}
		}
	}
	handle_errors {
		@asleep expression {err.status_code} in [502, 503, 504]
		redir @asleep /control/ 307
	}
}

(image_chat) {
	encode zstd gzip
