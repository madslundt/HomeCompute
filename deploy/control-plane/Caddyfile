# Deterministic image-chat acknowledgements stay on the private Docker network.
http://:8193 {
	@image_chat remote_ip {$OPEN_WEBUI_CLIENT_IP:172.28.210.5}
	handle @image_chat {
		reverse_proxy 172.28.200.1:18193
	}
	handle {
		respond "Forbidden" 403
	}
}

# LAN HTTP shares the standard port with Homepage. Match Daythread before
# forwarding the remaining hosts to Homepage's existing private publication.
http://:8080 {
	encode zstd gzip
	@comfyui host comfyui.home.arpa
	handle @comfyui {
		redir https://comfyui.home.arpa{uri} 308
	}
	@agent_office host agents.home.arpa
	handle @agent_office {
		redir https://agents.home.arpa{uri} 308
	}
	@daythread host {$DAYTHREAD_FQDN:daythread.home.arpa}
	handle @daythread {
		# Bootstrap client trust through HTTP; only the public root is served.
		handle /.well-known/home-core-root-ca.crt {
			root * /data/caddy/pki/authorities/local
			rewrite * /root.crt
			header Content-Type application/x-x509-ca-cert
			file_server
		}
		handle {
			reverse_proxy {$DAYTHREAD_UPSTREAM:omi-local-backend-1:8787}
		}
	}
	handle {
		reverse_proxy {$HOMEPAGE_HTTP_UPSTREAM}
	}
}

(litellm_proxy) {
	reverse_proxy litellm:4000 {
		# The edge owns CORS; avoid duplicate or credentialed upstream headers.
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Credentials
		health_uri /health/liveliness
		health_interval 30s
		lb_try_duration 5s
		transport http {
			dial_timeout 3s
			response_header_timeout 10m
		}
	}
}

import /config/video-api/Caddyfile

(ai_api) {
	encode zstd gzip
	import video_content_routes

	@llm_status {
		method GET
		path /llm/status
	}
	handle @llm_status {
		rewrite * /control/api/llm-status
		header Cache-Control no-store
		reverse_proxy 172.28.200.1:18189
	}
	@llm_activity {
		method GET
		path /llm/activity
	}
	handle @llm_activity {
		reverse_proxy 172.28.200.1:18190
	}

	@workflow_retrieval {
		remote_ip 172.28.201.2
		method POST
		path /internal/workflow-retrieval
	}
	handle @workflow_retrieval {
		request_body {
			max_size 256KB
		}
		reverse_proxy 172.28.200.1:18795 {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	# Background work waits as soon as a switch is requested. Protected
	# workflow turns retain admission for their remaining model/tool calls.
	@background_text {
		remote_ip {$DAYTHREAD_CLIENT_IP:172.28.210.6}
		method POST
		path /v1/chat/completions /v1/responses /v1/completions
	}
	forward_auth @background_text 172.28.200.1:18192 {
		uri /llm/admission
		header_up -Authorization
		header_up -X-Litellm-Api-Key
	}

	# Existing workflow turns may finish their later model calls during the
	# first drain phase. The intake gate closes only after those turns finish.
	@text_generation {
		method POST
		path /v1/chat/completions /v1/responses /v1/completions
	}
	forward_auth @text_generation 172.28.200.1:18191 {
		uri /health
		header_up -Authorization
		header_up -X-Litellm-Api-Key
	}

	# Accept SDK/checker trailing slashes without a redirect during preflight.
	@api_slash path /v1/ /v1/models/ /v1/responses/ /v1/chat/completions/ /v1/audio/transcriptions/ /v1/audio/speech/ /v1/embeddings/ /v1/videos/
	uri @api_slash strip_suffix /

	# Network admission controls keyless inference. Check optional credentials
	# with a GET so the original inference body remains untouched. A placeholder
	# or stale key must not prevent access to the already-public network models.
	@credentialed {
		method GET POST
		path /v1/models /v1/responses /v1/chat/completions /v1/audio/transcriptions /v1/audio/speech /v1/embeddings /v1/videos /v1/videos/*
		not {
			header !Authorization
			header !X-Litellm-Api-Key
		}
	}
	forward_auth @credentialed litellm:4000 {
		uri /v1/models
		transport http {
			dial_timeout 3s
			response_header_timeout 10s
		}
		@unrecognized status 401
		handle_response @unrecognized {
			request_header Authorization "Bearer {env.LITELLM_NETWORK_KEY}"
			request_header -X-Litellm-Api-Key
		}
	}
	@keyless {
		path /v1/models /v1/responses /v1/chat/completions /v1/audio/transcriptions /v1/audio/speech /v1/embeddings /v1/videos /v1/videos/*
		header !Authorization
		header !X-Litellm-Api-Key
	}
	request_header @keyless Authorization "Bearer {env.LITELLM_NETWORK_KEY}"

	@api path /v1/audio/transcriptions /v1/audio/speech /v1 /v1/ /v1/models /v1/models/ /v1/responses /v1/responses/ /v1/chat/completions /v1/chat/completions/ /v1/audio/transcriptions/ /v1/audio/speech/ /v1/embeddings /v1/embeddings/ /v1/videos /v1/videos/*
	header @api {
		Access-Control-Allow-Origin "*"
		-Access-Control-Allow-Credentials
		defer
	}
	@api_preflight {
		method OPTIONS
		path /v1 /v1/models /v1/responses /v1/chat/completions /v1/audio/transcriptions /v1/audio/speech /v1/embeddings /v1/videos /v1/videos/*
	}
	handle @api_preflight {
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "{http.request.header.Access-Control-Request-Headers}"
		header Access-Control-Allow-Private-Network "true"
		header Access-Control-Max-Age "600"
		header Vary "Access-Control-Request-Headers"
		respond "" 204
	}

	@health path /healthz
	@usage_redirect path /usage
	redir @usage_redirect /usage/ 308
	@usage {
		method GET HEAD
		path /usage/ /usage/index.html /usage/styles.css /usage/dashboard.js /usage/metrics.mjs /usage/icon.svg /usage/usage.json
	}
	handle @usage {
		uri strip_prefix /usage
		root * /data/token-usage
		header {
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
		file_server
	}
	handle @health {
		respond "ok" 200
	}

	@models {
		method GET
		path /v1/models
	}
	handle @models {
		request_body {
			max_size 32MB
		}
		import litellm_proxy
	}

	@standard {
		method POST
		path /v1/responses /v1/chat/completions /v1/audio/transcriptions /v1/audio/speech /v1/embeddings /v1/videos
	}
	handle @standard {
		request_body {
			max_size 32MB
		}
		import litellm_proxy
	}

	respond 404

	log {
		output stdout
		format filter {
			request>uri delete
			request>headers delete
		}
	}
}

