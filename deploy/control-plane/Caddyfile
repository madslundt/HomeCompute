# Native OpenClaw dashboard on the home LAN. The IP origin is accepted by
# OpenClaw's private same-origin checks; authentication and pairing stay native.
192.168.30.122 {
	tls internal
	encode zstd gzip
	reverse_proxy 172.28.200.1:18792
}

agents.home.arpa {
	tls internal
	encode zstd gzip
	@private remote_ip 192.168.30.0/24 192.168.10.0/24 100.64.0.0/10
	handle @private {
		# The observer still validates Origin and requires its own password.
		# Its native listener and both relay hops remain on private interfaces.
		reverse_proxy 172.28.200.1:18802 {
			header_up Host 127.0.0.1:18802
			header_up X-HomeCompute-Office-Origin https://agents.home.arpa
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
	}
	respond "Forbidden" 403
}

