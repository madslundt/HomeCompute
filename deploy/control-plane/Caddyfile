{
	admin off
	auto_https disable_redirects
	https_port {$CADDY_HTTPS_PORT}
	servers {
		protocols h1 h2
	}
}

{$AI_FQDN} {
	tls internal
	encode zstd gzip

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	@api path /v1/*
	handle @api {
		request_body {
			max_size 32MB
		}
		reverse_proxy litellm:4000 {
			health_uri /health/liveliness
			health_interval 30s
			lb_try_duration 5s
			transport http {
				dial_timeout 3s
				response_header_timeout 10m
			}
		}
	}

	respond 404

	log {
		output stdout
		format json
	}
}
