[Unit]
Description=Bounded public DNS for operator-approved OpenClaw native namespace
After=docker.service homecompute-openclaw-shutdown.service
Requires=docker.service
ConditionPathExists=/etc/homecompute-public-dns/identity.json
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -I /etc/homecompute-public-dns/openclaw-public-dns.py
Restart=on-failure
RestartSec=30
TimeoutStopSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_SETPCAP
# Preserve the already bounded UID transition capability across root exec
# with NoNewPrivileges; the fixed child clears every ambient capability.
AmbientCapabilities=CAP_SETUID
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=net
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=64
CPUQuota=50%
StandardOutput=journal
StandardError=null

[Install]
WantedBy=multi-user.target
