# Build with the repository root as context from a clean, published archive.
# A runtime-verified bundle pin is required; no model artifacts belong in this context.
ARG NATIVE_BASE_IMAGE
FROM ${NATIVE_BASE_IMAGE}
ARG HOME_COMPUTE_REVISION
ARG NATIVE_BASE_IMAGE
ARG NATIVE_SOURCE_REVISION
ARG OBSERVER_SOURCE_REVISION
ARG WHISPER_VERIFIED_BUILD_OWNER
LABEL io.homecompute.source-revision="${HOME_COMPUTE_REVISION}" \
      io.homecompute.whisper-verified-language.build-owner="${WHISPER_VERIFIED_BUILD_OWNER}" \
      io.homecompute.whisper-cpp.native-source-revision="${NATIVE_SOURCE_REVISION}" \
      io.homecompute.whisper-cpp.native-parent-image="${NATIVE_BASE_IMAGE}" \
      io.homecompute.whisper-cpp.observer-source-revision="${OBSERVER_SOURCE_REVISION}"
USER root
COPY deploy/whisper-cpp-stt/adapter.py deploy/whisper-cpp-stt/contract.py deploy/whisper-cpp-stt/verify_model.py /opt/homecompute/
COPY deploy/whisper-cpp-stt/recovery.py deploy/whisper-cpp-stt/silero_vad.py deploy/whisper-cpp-stt/language_boundaries.py deploy/whisper-cpp-stt/non_speech.py deploy/whisper-cpp-stt/overlap_repair.py deploy/whisper-cpp-stt/vad-pin.json /opt/homecompute/
COPY deploy/whisper-cpp-stt/language_observer.py deploy/whisper-cpp-stt/language-observer-pin.json /opt/homecompute/
COPY deploy/whisper-language-observer/common.py deploy/whisper-language-observer/graph.py deploy/whisper-language-observer/export.py deploy/whisper-language-observer/classify.py deploy/whisper-language-observer/installer_check.py deploy/whisper-language-observer/model.json deploy/whisper-language-observer/dependencies.json deploy/whisper-language-observer/requirements.lock /opt/homecompute/language-observer/
# Keep the bounded build worker observable for the resource verifier.
RUN nm -D --defined-only /usr/local/lib/libwhisper.so | grep -Eq '[[:space:]]T[[:space:]]whisper_full_with_endpoint_spans$' \
 && python3 -I -B -c 'import hashlib,json,os;from pathlib import Path;p=Path("/opt/homecompute");v=json.loads((p/"language-observer-pin.json").read_bytes());assert v["source_revision"]==os.environ["OBSERVER_SOURCE_REVISION"];assert len(v["code_sha256"])==8;assert set(v["code_sha256"])=={f.name for f in (p/"language-observer").iterdir()};assert all(hashlib.sha256((p/"language-observer"/n).read_bytes()).hexdigest()==h for n,h in v["code_sha256"].items())' \
 && python3 -I -B /opt/homecompute/silero_vad.py --provision \
 && chmod 0555 /opt/homecompute/*.py /opt/homecompute/language-observer/*.py \
 && chmod 0444 /opt/homecompute/*-pin.json /opt/homecompute/ggml-silero-v5.1.2.bin /opt/homecompute/language-observer/*.json /opt/homecompute/language-observer/requirements.lock \
 && sleep 2
ENV WHISPER_CPP_HOME_COMPUTE_REVISION=${HOME_COMPUTE_REVISION} \
    WHISPER_CPP_RECOVER_TRAILING_SPEECH=true \
    WHISPER_CPP_LANGUAGE_BOUNDARIES=true \
    WHISPER_CPP_FILTER_NON_SPEECH=true \
    WHISPER_CPP_LOCAL_EOT_RANKING=true \
    WHISPER_CPP_VERIFY_LANGUAGE_ISLANDS=true
USER 10001:10001
