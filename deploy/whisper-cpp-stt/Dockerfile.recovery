# Isolated ranking diagnostic: exact hc11/v7 native engine with the unchanged
# h17 adapter recovery/language/non-speech policies and pinned detector bytes.
FROM sha256:84abcd6b3489162a6e479c29411acbb68598b9a4f48096e3372ee64b1aa6d8d4 AS detector
FROM sha256:dd7c842ebe50ba85773d21653cb1c29353b622848cfa709140123d5d375a2f22
ARG HOME_COMPUTE_REVISION
LABEL io.homecompute.source-revision="${HOME_COMPUTE_REVISION}" \
      io.homecompute.whisper-cpp.native-source-revision="b440dae9d55d2419c72520dcd098d980ea30ba41" \
      io.homecompute.whisper-cpp.native-parent-image="sha256:dd7c842ebe50ba85773d21653cb1c29353b622848cfa709140123d5d375a2f22" \
      io.homecompute.whisper-cpp.detector-parent-image="sha256:84abcd6b3489162a6e479c29411acbb68598b9a4f48096e3372ee64b1aa6d8d4" \
      io.homecompute.whisper-cpp.recovery="silero-v5.1.2-cpu-prob0.5-grace500ms-contiguous512ms-suffix-v1"
USER root
COPY adapter.py contract.py verify_model.py recovery.py silero_vad.py language_boundaries.py non_speech.py vad-pin.json /opt/homecompute/
COPY --from=detector /opt/homecompute/ggml-silero-v5.1.2.bin /opt/homecompute/
RUN python3 -I -B /opt/homecompute/silero_vad.py --provision \
 && chmod 0555 /opt/homecompute/*.py \
 && chmod 0444 /opt/homecompute/vad-pin.json /opt/homecompute/ggml-silero-v5.1.2.bin
ENV WHISPER_CPP_HOME_COMPUTE_REVISION=${HOME_COMPUTE_REVISION} \
    WHISPER_CPP_RECOVER_TRAILING_SPEECH=true \
    WHISPER_CPP_LANGUAGE_BOUNDARIES=true \
    WHISPER_CPP_FILTER_NON_SPEECH=true
USER 10001:10001
