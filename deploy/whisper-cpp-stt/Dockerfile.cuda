ARG CUDA_BASE_IMAGE=nvcr.io/nvidia/pytorch@sha256:8014e4ffc674ae9cc9aecad04b64b29c3d311ed738e54ac3042d2d45690d19e9
FROM --platform=linux/arm64 ${CUDA_BASE_IMAGE} AS build
ARG CUDA_BASE_IMAGE
ARG WHISPER_CPP_COMMIT=f049fff95a089aa9969deb009cdd4892b3e74916
ARG HOME_COMPUTE_REVISION
ARG CUDA_PATCHER_SHA256=e5ced318cad21fedc9d97d39c00a997d99812f6e78c0151b31001014b338f42a
LABEL org.opencontainers.image.source="https://github.com/ggml-org/whisper.cpp" \
      org.opencontainers.image.revision="${WHISPER_CPP_COMMIT}" \
      io.homecompute.source-revision="${HOME_COMPUTE_REVISION}" \
      io.homecompute.whisper-cpp.runtime-commit="${WHISPER_CPP_COMMIT}" \
      io.homecompute.whisper-cpp.model-sha256="64d182b440b98d5203c4f9bd541544d84c605196c4f7b845dfa11fb23594d1e2" \
      io.homecompute.whisper-cpp.cuda-patch="strict-gpu-local-eot-ranking-v8" \
      io.homecompute.whisper-cpp.cuda-patcher-sha256="${CUDA_PATCHER_SHA256}" \
      io.homecompute.whisper-cpp.backend="cuda-121a" \
      io.homecompute.whisper-cpp.cuda-base="${CUDA_BASE_IMAGE}"

RUN nvcc --version | grep -q 'release 13.1, V13.1.115' \
 && test "$(cmake --version | head -n 1)" = 'cmake version 3.31.6' \
 && test "$(gcc -dumpfullversion)" = '13.3.0'
COPY patch-whisper-cpp-cuda.py whisper-cpp-trace-patch.py whisper-cpp-local-eot-patch.py /opt/homecompute/
COPY verify-cuda-linkage.py /opt/homecompute/verify-cuda-linkage.py
RUN echo "${CUDA_PATCHER_SHA256}  /opt/homecompute/patch-whisper-cpp-cuda.py" | sha256sum -c -
RUN git init /src \
 && git -C /src remote add origin https://github.com/ggml-org/whisper.cpp.git \
 && git -C /src fetch --depth=1 origin "${WHISPER_CPP_COMMIT}" \
 && git -C /src checkout --detach FETCH_HEAD \
 && test "$(git -C /src rev-parse HEAD)" = "${WHISPER_CPP_COMMIT}" \
 && python3 /opt/homecompute/patch-whisper-cpp-cuda.py --source /src \
 && grep -Fq 'params.max_len = std::stoi(req.get_file_value("max_len").content);' /src/examples/server/server.cpp \
 && grep -Fq 'wparams.max_len          = params.max_len == 0 ? 60 : params.max_len;' /src/examples/server/server.cpp \
 && grep -Fq 'if (params.max_len > 0) {' /src/src/whisper.cpp
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=121a-real -DGGML_CUDA=ON -DGGML_NATIVE=OFF \
      -DGGML_OPENMP=ON -DGGML_METAL=OFF -DWHISPER_BUILD_TESTS=OFF \
      -DWHISPER_BUILD_EXAMPLES=ON -DWHISPER_BUILD_SERVER=ON \
 && cmake --build /build --config Release --target whisper-server --parallel 4
RUN printf '%s\n' 'extern int cuInit(unsigned int); int main(void) { return cuInit(0); }' > /tmp/driver-probe.c \
 && test -f /usr/local/cuda/targets/sbsa-linux/lib/stubs/libcuda.so \
 && gcc /tmp/driver-probe.c -L/usr/local/cuda/targets/sbsa-linux/lib/stubs -lcuda -o /tmp/driver-probe \
 && ldd /tmp/driver-probe > /tmp/driver-probe.ldd \
 && python3 /opt/homecompute/verify-cuda-linkage.py --driver-probe /tmp/driver-probe.ldd \
 && rm /tmp/driver-probe.c /tmp/driver-probe /tmp/driver-probe.ldd

FROM --platform=linux/arm64 ${CUDA_BASE_IMAGE} AS runtime
ARG CUDA_BASE_IMAGE
ARG WHISPER_CPP_COMMIT=f049fff95a089aa9969deb009cdd4892b3e74916
ARG HOME_COMPUTE_REVISION
ARG CUDA_PATCHER_SHA256=e5ced318cad21fedc9d97d39c00a997d99812f6e78c0151b31001014b338f42a
LABEL org.opencontainers.image.source="https://github.com/ggml-org/whisper.cpp" \
      org.opencontainers.image.revision="${WHISPER_CPP_COMMIT}" \
      io.homecompute.source-revision="${HOME_COMPUTE_REVISION}" \
      io.homecompute.whisper-cpp.runtime-commit="${WHISPER_CPP_COMMIT}" \
      io.homecompute.whisper-cpp.model-sha256="64d182b440b98d5203c4f9bd541544d84c605196c4f7b845dfa11fb23594d1e2" \
      io.homecompute.whisper-cpp.cuda-patch="strict-gpu-local-eot-ranking-v8" \
      io.homecompute.whisper-cpp.cuda-patcher-sha256="${CUDA_PATCHER_SHA256}" \
      io.homecompute.whisper-cpp.backend="cuda-121a" \
      io.homecompute.whisper-cpp.cuda-base="${CUDA_BASE_IMAGE}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    LD_LIBRARY_PATH=/usr/local/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64:/usr/local/cuda/targets/sbsa-linux/lib
RUN groupadd --gid 10001 stt \
 && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin stt \
 && mkdir -p /opt/homecompute /models \
 && chown root:root /opt/homecompute /models \
 && chmod 0555 /opt/homecompute /models
COPY --from=build /build/bin/whisper-server /usr/local/bin/whisper-server
COPY --from=build /build/bin/lib*.so* /usr/local/lib/
COPY adapter.py contract.py verify_model.py /opt/homecompute/
COPY recovery.py silero_vad.py language_boundaries.py non_speech.py overlap_repair.py vad-pin.json /opt/homecompute/
COPY verify-cuda-linkage.py /opt/homecompute/
RUN python3 -I -B /opt/homecompute/silero_vad.py --provision
ENV WHISPER_CPP_HOME_COMPUTE_REVISION=${HOME_COMPUTE_REVISION}
RUN chmod 0555 /usr/local/bin/whisper-server /usr/local/lib/lib*.so* \
 && chmod 0555 /opt/homecompute/adapter.py /opt/homecompute/contract.py /opt/homecompute/verify_model.py /opt/homecompute/recovery.py /opt/homecompute/language_boundaries.py /opt/homecompute/non_speech.py /opt/homecompute/overlap_repair.py /opt/homecompute/verify-cuda-linkage.py \
 && ldd /usr/local/bin/whisper-server > /tmp/whisper-server.ldd \
 && python3 /opt/homecompute/verify-cuda-linkage.py /tmp/whisper-server.ldd \
 && rm /tmp/whisper-server.ldd
USER 10001:10001
EXPOSE 8000
ENTRYPOINT ["python3", "-I", "-B", "/opt/homecompute/adapter.py"]
