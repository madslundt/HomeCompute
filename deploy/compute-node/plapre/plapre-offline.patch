+class _CrossDeviceModule(nn.Module):
+    """Run one unsupported GB10 operator on CPU and return to its caller's device."""
+
+    def __init__(self, module: nn.Module, output_device: torch.device):
+        super().__init__()
+        self.module = module
+        self.output_device = output_device
+
+    def forward(self, value: torch.Tensor) -> torch.Tensor:
+        return self.module(value.cpu()).to(self.output_device)
+
