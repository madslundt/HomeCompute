[Unit]
Description=Private VM bridge proxy for the authenticated agent office
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-operator
Group=hermes-operator
ExecStart=/usr/bin/socat TCP4-LISTEN:18803,bind=10.77.20.2,reuseaddr,fork TCP4:127.0.0.1:18802
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
