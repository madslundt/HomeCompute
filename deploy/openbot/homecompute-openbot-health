#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONTAINER=homecompute-openbot
readonly IMAGE_REF=ghcr.io/nightly-labs/openbot@sha256:ed12869034791a3c9de905d3d164185512c4dba191780d38a7c7a9099eab6a2d

running=false
for ((attempt = 0; attempt < 30; attempt++)); do
  running="$(docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true)"
  [[ "$running" == true ]] && break
  sleep 2
done
[[ "$running" == true ]] || { echo 'OpenBot container is not running' >&2; exit 1; }
ports="$(docker inspect --format '{{json .HostConfig.PortBindings}}' "$CONTAINER")"
[[ "$ports" == null || "$ports" == '{}' ]] || { echo 'OpenBot must not publish host ports' >&2; exit 1; }
configured_image="$(docker inspect --format '{{.Config.Image}}' "$CONTAINER")"
[[ "$configured_image" == "$IMAGE_REF" ]] || { echo 'OpenBot container does not use the release image pin' >&2; exit 1; }
running_image_id="$(docker inspect --format '{{.Image}}' "$CONTAINER")"
release_image_id="$(docker image inspect --format '{{.Id}}' "$IMAGE_REF")"
[[ "$running_image_id" == "$release_image_id" ]] || { echo 'Running OpenBot image differs from the release image pin' >&2; exit 1; }
