#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONTAINER=homecompute-openbot
readonly IMAGE_DIGEST=sha256:a84be4b5bf7aa0aaf85486b5b6970f41b9051e5294f298163507efe6604d522d

running=false
for ((attempt = 0; attempt < 30; attempt++)); do
  running="$(docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true)"
  [[ "$running" == true ]] && break
  sleep 2
done
[[ "$running" == true ]] || { echo 'OpenBot container is not running' >&2; exit 1; }
ports="$(docker inspect --format '{{json .HostConfig.PortBindings}}' "$CONTAINER")"
[[ "$ports" == null || "$ports" == '{}' ]] || { echo 'OpenBot must not publish host ports' >&2; exit 1; }
digests="$(docker image inspect --format '{{json .RepoDigests}}' "ghcr.io/nightly-labs/openbot@$IMAGE_DIGEST")"
[[ "$digests" == *"@$IMAGE_DIGEST"* ]] || { echo 'OpenBot image digest does not match the reviewed pin' >&2; exit 1; }
