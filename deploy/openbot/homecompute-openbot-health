#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONTAINER=homecompute-openbot
readonly IMAGE_REF=ghcr.io/nightly-labs/openbot:latest

running=false
for ((attempt = 0; attempt < 30; attempt++)); do
  running="$(docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true)"
  [[ "$running" == true ]] && break
  sleep 2
done
[[ "$running" == true ]] || { echo 'OpenBot container is not running' >&2; exit 1; }
ports="$(docker inspect --format '{{json .HostConfig.PortBindings}}' "$CONTAINER")"
[[ "$ports" == null || "$ports" == '{}' ]] || { echo 'OpenBot must not publish host ports' >&2; exit 1; }
configured_image="$(docker inspect --format '{{.Config.Image}}' "$CONTAINER")"
[[ "$configured_image" == "$IMAGE_REF" ]] || { echo 'OpenBot container is not configured from the latest tag' >&2; exit 1; }
running_image_id="$(docker inspect --format '{{.Image}}' "$CONTAINER")"
latest_image_id="$(docker image inspect --format '{{.Id}}' "$IMAGE_REF")"
[[ "$running_image_id" == "$latest_image_id" ]] || { echo 'Running OpenBot image differs from the pulled latest tag' >&2; exit 1; }
